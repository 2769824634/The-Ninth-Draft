---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'The Ninth Draft — the Records Office of Gerimis, 1999. Everything on the island is normal. If it isn\'t, it\'s the previous draft.' } = Astro.props;
const base = import.meta.env.BASE_URL;
// Chinese faces, one per role. unicode-range keeps the English site from ever
// downloading them; the build trims each file to the characters in use.
const CJK = 'U+2E80-2FDF, U+3000-303F, U+3400-4DBF, U+4E00-9FFF, U+F900-FAFF, U+FE30-FE4F, U+FF00-FFEF';
const zhFaces = [
  ['N9 KuHei', 'kuhei'],
  ['N9 HuoSong', 'huosong'],
  ['N9 DIN', 'din-con'],
  ['N9 DIN Bold', 'din-bold'],
  ['N9 Bitmap', 'bitmap'],
  ['N9 Fangsong', 'fangsong'],
]
  .map(([family, file]) => `@font-face{font-family:'${family}';src:url('${base}fonts/zh/${file}.woff2') format('woff2');font-display:swap;unicode-range:${CJK}}`)
  .join('');
---

<!doctype html>
<html lang="en" data-theme="day" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e4e3de" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <style set:html={zhFaces}></style>
    <script is:inline>
      // Apply saved theme and language before first paint to avoid a flash.
      try {
        const p = JSON.parse(localStorage.getItem('n9:prefs') || '{}');
        // Lighting follows island time (Singapore, UTC+8; day 07:00–19:00) unless chosen this half-day.
        const at = Date.now() + 8 * 36e5, h = new Date(at).getUTCHours();
        const half = Math.floor((at - 7 * 36e5) / 432e5);
        document.documentElement.dataset.theme = p.themeHalf === half && (p.theme === 'night' || p.theme === 'day') ? p.theme : h < 7 || h >= 19 ? 'night' : 'day';
        if (p.lang === 'zh') {
          document.documentElement.lang = 'zh-CN';
          document.documentElement.dataset.lang = 'zh';
        }
      } catch (_) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
