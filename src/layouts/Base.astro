---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'The Ninth Draft — an archive of declassified records.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e4e3de" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Apply saved theme before first paint to avoid a flash.
      try {
        const t = JSON.parse(localStorage.getItem('n9:prefs') || '{}').theme;
        if (t === 'night' || t === 'day') document.documentElement.dataset.theme = t;
      } catch (_) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
