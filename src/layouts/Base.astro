---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'The Ninth Draft — the Records Office of Gerimis, 1999. Everything on the island is normal. Where it differs, go by what you see.' } = Astro.props;
const base = import.meta.env.BASE_URL;
// Chinese faces, one per role, cut into slices at build time (see
// integrations/zh-fonts.mjs); each slice downloads only when a page shows
// one of its characters, so the English site never fetches them.
---

<!doctype html>
<html lang="en" data-theme="day" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e4e3de" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${base}fonts/zh/faces.css`} />
    <script is:inline>
      // Apply saved theme and language before first paint to avoid a flash.
      try {
        const p = JSON.parse(localStorage.getItem('n9:prefs') || '{}');
        // Lighting follows island time (Singapore, UTC+8; day 07:00–19:00) unless chosen this half-day.
        const at = Date.now() + 8 * 36e5, h = new Date(at).getUTCHours();
        const half = Math.floor((at - 7 * 36e5) / 432e5);
        // Check mode (screenshots, see src/app/check.ts): ?check&theme=night&lang=zh, no boot cover, no nags
        const q = new URLSearchParams(location.search);
        if (q.has('check')) {
          const th = q.get('theme'), lg = q.get('lang');
          if (th === 'day' || th === 'night') Object.assign(p, { theme: th, themeHalf: half });
          if (lg === 'en' || lg === 'zh') p.lang = lg;
          localStorage.setItem('n9:prefs', JSON.stringify(p));
          for (const k of ['n9:boot', 'n9:nag', 'n9:chapter']) sessionStorage.setItem(k, '1');
        }
        document.documentElement.dataset.theme = p.themeHalf === half && (p.theme === 'night' || p.theme === 'day') ? p.theme : h < 7 || h >= 19 ? 'night' : 'day';
        if (p.lang === 'zh') {
          document.documentElement.lang = 'zh-CN';
          document.documentElement.dataset.lang = 'zh';
        }
      } catch (_) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
