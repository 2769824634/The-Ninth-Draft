---
/**
 * Flat pages (registration, the visitor's file, the map, the guide): the same
 * archive header without the 3D room, so they load fast and read on a phone.
 */
import Base from './Base.astro';
import SiteNav, { type NavId } from '../components/SiteNav.astro';
import '../styles/hud.css';
import '../styles/zh.css';
import '../styles/flat.css';
import '../styles/fileslip.css';
import { CATEGORIES, loadRecords } from '../lib/records';

interface Props {
  title: string;
  description?: string;
  page: 'register' | 'me' | 'map' | 'guide' | 'calendar' | 'district' | 'baseline' | 'daily' | 'library' | 'office';
}
const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL;
// Every file on record, small: a file mentioned on this page opens a call
// slip here (where it is kept, what it says) instead of carrying the reader off.
const fileIndex = (await loadRecords(base)).map((r) => ({
  file: r.file,
  slug: r.slug,
  category: r.category,
  stamp: r.stamp,
  date: r.date,
  en: { title: r.title, subtitle: r.subtitle, place: r.place, summary: r.summary },
  zh: r.zh ? { title: r.zh.title, subtitle: r.zh.subtitle, place: r.zh.place, summary: r.zh.summary } : undefined,
}));
const categories = CATEGORIES.map((c) => c.id);
// pages that belong to a room light up that room
const ROOM: Partial<Record<Props['page'], NavId>> = { map: 'map', district: 'map', library: 'library', daily: 'library', office: 'office', calendar: 'office' };
const current: NavId | null = ROOM[page] ?? null;
---

<Base title={title} description={description}>
  <div class="flat" data-page={page}>
    <header class="fhead">
      <a class="brand__link fhead__brand" href={base} aria-label="Public Archive — overview">
        <span class="brand__l1">Gerimis Records Office</span>
        <span class="brand__l2">Public Archive</span>
      </a>
      <SiteNav current={current} />
      <div class="fhead__tools tools">
        <a class="tool" id="nav-me" href={`${base}register/`} aria-current={page === 'register' || page === 'me' ? 'page' : undefined}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="3" width="13" height="10" /><circle cx="5.6" cy="7.2" r="1.6" /><path d="M3.2 11c.5-1.3 1.3-1.9 2.4-1.9s1.9.6 2.4 1.9M9.8 6.6h3M9.8 8.8h2.2" /></svg>
          <span>Register</span>
        </a>
        <a class="tool" id="nav-guide" href={`${base}guide/`} aria-current={page === 'guide' ? 'page' : undefined}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2.5h7.5l2.5 2.5v8.5H3z" /><path d="M5.5 7h5M5.5 9.5h5M5.5 12h3" /></svg>
          <span>Guide</span>
        </a>
        <a class="tool" id="btn-index" href={`${base}#index`}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.6" /><path d="M10.4 10.4 14 14" /></svg>
          <span>Index</span><span class="kbd">/</span>
        </a>
        <div class="seg" role="group" aria-label="Lighting">
          <span class="seg__thumb" aria-hidden="true"></span>
          <button type="button" data-theme-set="day" aria-pressed="true">Day</button>
          <button type="button" data-theme-set="night" aria-pressed="false">Night</button>
        </div>
        <button class="tool tool--lang" id="btn-lang" type="button" aria-label="Language">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <rect class="pg pg--a" x="2" y="1.5" width="8" height="10" />
            <g class="pg pg--b"><rect x="6" y="4.5" width="8" height="10" /><path d="M8 8h4M8 10.5h2.6" /></g>
          </svg>
          <span class="lang__pair" aria-hidden="true"><b lang="en">EN</b><i>/</i><b lang="zh-CN">中</b></span><span class="kbd">L</span>
        </button>
        <button class="tool tool--sound" id="btn-sound" type="button" aria-pressed="false">
          <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span id="sound-label">Sound off</span>
        </button>
      </div>
    </header>
    <main class="fmain" id="fmain">
      <slot />
    </main>
    <footer class="ffoot micro">
      <span class="ffoot__time" data-island-clock data-no-i18n>Records Office · Gerimis · 1999</span>
      <span><span>Everything on the island is normal.</span> <span>If it isn't, it's the previous draft.</span></span>
    </footer>
  </div>
  <script type="application/json" id="file-index" set:html={JSON.stringify({ categories, files: fileIndex }).replace(/</g, '\\u003c')} />
</Base>
