---
import Flat from '../../layouts/Flat.astro';
import SealedEnvelope from '../../components/SealedEnvelope.astro';
import StreetMap from '../../components/StreetMap.astro';
import '../../styles/envelope.css';
import '../../styles/idcard.css';

const base = import.meta.env.BASE_URL;
const arrow = '<svg viewBox="0 0 24 12" aria-hidden="true"><path d="M0 6h22M17 1l5 5-5 5" /></svg>';
---

<Flat title="My home — The Ninth Draft" description="Your flat in Gerimis: the door, the letterbox, the card." page="me">
  <section class="me__none" id="none" hidden>
    <p class="f-kicker micro"><b>No home</b><span>Records Office · Residents' Register</span></p>
    <h1 class="f-title"><span data-l="en">No home on record</span><span data-l="zh">查无住址</span></h1>
    <p class="f-lede" id="none-text"><span data-l="en">The Office has no flat for you on this device. Either you have not registered at Window 3, or you have been revised out. The form takes a few minutes.</span><span data-l="zh">这台设备上没有你的住址。要么你还没去三号窗口登记，要么已经被修订掉了。填表要几分钟。</span></p>
    <div class="me__acts">
      <a class="f-btn" href={`${base}register/resident/`}><span>Apply for residence</span><Fragment set:html={arrow} /></a>
      <a class="f-btn f-btn--ghost" href={`${base}register/`}><span>Visitors' book</span></a>
    </div>
  </section>

  <SealedEnvelope />

  <div class="home" id="file" hidden>
    <div>
      <header class="me__head">
        <div class="me__crumbs micro"><span id="me-file">File V-0000</span><span>Residents' Register</span></div>
        <p class="home__door" id="me-door">#00-000</p>
        <p class="home__addr" id="me-addr"></p>
        <p class="home__post" id="me-post"></p>
        <dl class="me__meta" id="me-meta"></dl>
      </header>

      <section class="f-sec" id="redraw" hidden>
        <h2 class="f-sec__h"><i>00</i><span>A flat owed</span></h2>
        <p class="f-help" style="margin-top:0" id="redraw-text"></p>
        <div class="drum">
          <button type="button" class="drum__wheel" id="drum" aria-label="Turn the drum"></button>
          <div class="drum__slip" id="slip"></div>
        </div>
      </section>

      <section class="f-sec" id="sec-box">
        <h2 class="f-sec__h"><i>01</i><span>Letterbox</span></h2>
        <div class="mbox" id="mbox" aria-label="Letterboxes on your floor"></div>
        <p class="mbox__note" id="mbox-note"></p>
        <ul class="mail" id="mail"></ul>
      </section>

      <section class="f-sec" id="sec-down">
        <h2 class="f-sec__h"><i>02</i><span>Downstairs</span></h2>
        <div class="meet" id="meet" aria-live="polite"></div>
        <div class="board" id="board" aria-label="Notice board at the void deck"></div>
      </section>

      <section class="f-sec" id="sec-map">
        <h2 class="f-sec__h"><i>03</i><span>On the map</span></h2>
        <StreetMap id="home-map" />
        <p class="mbox__note" id="downstairs"></p>
      </section>

      <section class="f-sec">
        <h2 class="f-sec__h"><i>04</i><span>Recovery phrase</span></h2>
        <p class="f-help" style="margin-top:0"><span data-l="en">Your codename and these words bring your home back on another device.</span><span data-l="zh">代号加这几个词，可以在别的设备上回家。</span></p>
        <button class="f-btn f-btn--ghost" type="button" id="show-phrase" style="margin-top:.8rem"><span>Show phrase</span></button>
        <ol class="phrase me__phrase" id="me-phrase" hidden></ol>
      </section>

      <div class="me__acts">
        <a class="f-btn" href={base}><span>Back to the archive</span><Fragment set:html={arrow} /></a>
        <a class="f-btn f-btn--ghost" href={`${base}baseline/`}><span>Baseline test</span></a>
        <button class="f-btn f-btn--ghost" type="button" id="reseal"><span data-l="en">Seal it again</span><span data-l="zh">重新封上</span></button>
        <button class="f-btn f-btn--ghost" type="button" id="forget"><span>Revise me out</span></button>
      </div>
    </div>

    <aside class="home__side">
      <div>
        <div class="idc" id="card" role="button" tabindex="0" aria-label="Your identity card. Tap to turn it over."><div class="idc__in" id="card-in"></div></div>
        <p class="idc__flip micro"><span data-l="en">Tap the card to turn it over.</span><span data-l="zh">点一下身份证翻面。</span></p>
      </div>
      <div class="keytag" id="key" aria-hidden="true" hidden><svg viewBox="0 0 46 20"><circle cx="9" cy="10" r="7" /><circle cx="9" cy="10" r="2.4" /><path d="M16 10h28M36 10v5M40 10v4" /></svg><span id="keyno"></span></div>
    </aside>
  </div>
</Flat>

<script>
  import { flat } from '../../app/flat';
  import { audio } from '../../app/audio';
  import { isZh, t } from '../../app/i18n';
  import { districtName } from '../../app/visitor/districts';
  import { toPhrase } from '../../app/visitor/phrase';
  import { fileNo, forgetVisitor, homeFileNo, loadVisitor, saveVisitor, type Visitor } from '../../app/visitor/store';
  import { addressLine, ballot, codeRow, doorText, homeBlocks, postLine, DOORS } from '../../app/visitor/home';
  import { cardHTML, cardPhoto, issued } from '../../app/visitor/idcard';
  import { loadBaseline, VERDICTS } from '../../app/baseline/rounds';
  import { keepOpened, opened, reseal, sealed } from '../../app/visitor/envelope';
  import { mountStreetMap } from '../../app/map/mount';
  import { reducedMotion } from '../../app/prefs';
  import { household, letters, notices, previousTenant, type Letter } from '../../app/visitor/households';
  import { countVisit, encounter } from '../../app/visitor/encounters';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  let v = loadVisitor();
  const baseline = loadBaseline();
  const tx = (l: { en: string; zh: string }) => (isZh() ? l.zh : l.en);
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const card = $('card'), cardIn = $('card-in');
  let sm: ReturnType<typeof mountStreetMap> | null = null;
  let downstairs: string[][] = [];
  // the year the block went up: households cannot have moved in before it
  let built = 1975;
  const visit = loadVisitor()?.home ? countVisit() : null;
  const openLetters = new Set<number>();
  const STAMP: Record<Letter['kind'], string> = { bill: 'STATEMENT', postcard: 'AIR MAIL', paper: 'PRINTED MATTER', clinic: 'APPOINTMENT', draw: 'BY HAND', licence: 'OFFICIAL', note: 'BY HAND', office: 'BY HAND' };

  const render = () => {
    if (!v) return;
    const zh = isZh();
    const no = fileNo(v);
    const h = v.home;
    const mail = h ? letters(v, built) : [];
    document.title = t('{file} · My home — The Ninth Draft', { file: no });
    $('me-file').textContent = `${t('File')} ${no}`;
    $('me-door').textContent = h ? doorText(h) : zh ? '待分配' : 'TO BE ALLOTTED';
    $('me-addr').textContent = h ? `${addressLine(h, zh)}, ${districtName(v.district, zh)}` : districtName(v.district, zh);
    $('me-post').textContent = h ? postLine(h, zh) : '';
    const meta: [string, string][] = [
      [t('Name'), v.code],
      [t('Status'), t('Resident')],
      [t('District'), districtName(v.district, zh)],
      [t('Card'), codeRow({ ...v, origin: v.origin ?? 'N' })],
      [t('Filed'), issued(v.at)],
      [t('Baseline'), baseline ? `${tx(VERDICTS[baseline.verdict].name)} · ${baseline.score}` : t('Not tested')],
    ];
    $('me-meta').innerHTML = meta.map(([k, val]) => `<div><dt class="micro">${k}</dt><dd>${esc(val)}</dd></div>`).join('');
    cardIn.innerHTML = cardHTML({ ...v, origin: v.origin ?? 'N' }, { reissued: v.origin === 'G' });
    cardPhoto(cardIn, `${v.code}|${v.origin}|${v.no}`);
    // the letterboxes on your floor, yours in the middle of the row
    $('sec-box').hidden = !h;
    $('sec-map').hidden = !h;
    $('sec-down').hidden = !h;
    $('key').hidden = !h;
    if (h) {
      $('keyno').textContent = `${h.blk} ${doorText(h)}`;
      $('mbox').innerHTML = Array.from({ length: DOORS }, (_, k) => {
        const d = { ...h, stack: k };
        const mine = k === h.stack;
        const hh = mine ? null : household(d, built);
        const plate = mine ? esc(v!.code.toUpperCase()) : hh ? esc(zh ? hh.zh : hh.plate) : '';
        return `<div class="mbox__slot${mine ? ' is-mine' : ''}${!mine && !hh ? ' is-empty' : ''}"><span>${doorText(d)}</span><b>${plate}</b>${mine && mail.length ? `<i class="mbox__in">${mail.length}</i>` : ''}</div>`;
      }).join('');
      const prev = previousTenant(h, built);
      $('mbox-note').textContent = !mail.length
        ? zh ? '信箱是空的。邮差平日上午十点以后才来。' : 'Empty. The postman comes after ten on weekdays.'
        : v!.origin === 'G'
          ? zh ? `${mail.length} 封。你家搬走以后，这里空了一阵，寄给你的信都退到了管理处。你回来了，管理处把信连同一张条子放进信箱。` : `${mail.length} letters. After your family moved out the flat stood empty, and post for you went back to the estate office. Now that you are back, they have put it in your box with a note.`
          : !prev
          ? zh ? `${mail.length} 封，都是你的。这座楼 ${built} 年才建好，你是这个单位的第一户人家。` : `${mail.length} letters, all yours. The block went up in ${built} and you are the first to live in this flat.`
          : zh ? `${mail.length} 封，大多寄给前任住户 ${prev.plate}。他们 ${prev.since} 年搬进来，${prev.left} 年搬走，有些人还不知道新地址。最上面那张是他们留给下一户的条子。` : `${mail.length} letters, mostly for ${prev.plate}, who lived here from ${prev.since} to ${prev.left}. Not everyone has their new address yet. The one on top is a note they left for whoever came next.`;
      $('mail').innerHTML = mail.map((l, i) => `<li class="mail__l mail__l--${l.kind}${openLetters.has(i) ? ' is-open' : ''}" data-i="${i}">
          <button type="button" class="mail__env" aria-expanded="${openLetters.has(i)}"><span class="mail__from">${esc(tx(l.from))}</span><span class="mail__to">${esc(l.to)}<br>${esc(doorText(h))}</span><span class="mail__pm micro">${l.date}</span><span class="mail__stamp micro">${STAMP[l.kind]}</span></button>
          <div class="mail__body">${tx(l.body).split('\n\n').map((p) => `<p>${esc(p).replace(/\n/g, '<br>')}</p>`).join('')}</div></li>`).join('');
      renderDown();
      $('downstairs').textContent = downstairs.length ? `${zh ? '楼下：' : 'Downstairs: '}${downstairs.map((f) => (zh && f[1] ? f[1] : f[0])).join(zh ? '、' : ', ')}` : '';
    }
    renderRedraw();
  };

  /* ---------- downstairs: who you run into, and the notice board ---------- */
  const meetAt = Date.now();
  const renderDown = () => {
    if (!v?.home) return;
    const zh = isZh();
    const e = visit ? encounter(v, visit.before, meetAt, built) : null;
    $('meet').innerHTML = e
      ? `<p class="meet__who micro">${e.who ? `${esc(tx(e.who.name))} · ${esc(tx(e.who.role))}` : zh ? '楼下' : 'Downstairs'}</p><p class="meet__scene">${esc(tx(e.scene))}</p>${e.say ? `<p class="meet__line">${esc(zh ? `「${tx(e.say)}」` : `“${tx(e.say)}”`)}</p>` : ''}`
      : '';
    $('board').innerHTML = `<p class="board__h micro">${zh ? `${v.home.blk} 座楼下 · 告示板` : `Blk ${esc(v.home.blk)} · void deck notice board`}</p>` +
      notices(v.home, built).map((n, i) => `<div class="board__n" style="--r:${((i * 37) % 7) - 3}deg"><p class="board__t">${esc(tx(n.head))}</p><p>${esc(tx(n.text))}</p><p class="board__by">— ${esc(tx(n.by))}</p></div>`).join('');
  };
  $('mail').addEventListener('click', (ev) => {
    const li = (ev.target as HTMLElement).closest<HTMLElement>('.mail__l');
    if (!li) return;
    const i = Number(li.dataset.i);
    if (openLetters.has(i)) openLetters.delete(i); else openLetters.add(i);
    li.classList.toggle('is-open', openLetters.has(i));
    li.querySelector('button')!.setAttribute('aria-expanded', String(openLetters.has(i)));
    audio.paper();
  });

  /* ---------- a registration from before the form changed: a flat owed ---------- */
  let turning = false;
  const renderRedraw = () => {
    if (!v) return;
    const owed = !v.home;
    $('redraw').hidden = !owed;
    if (!owed) return;
    const zh = isZh();
    $('redraw-text').textContent = zh
      ? `你是在表格改版之前登记的，三号窗口还欠你一间屋子，按新抵岛人士在${districtName(v.district, true)}补抽。档案编号会换成新的，恢复口令也变成六个词。`
      : `You registered before the form changed. Window 3 still owes you a flat: a ballot in ${districtName(v.district, false)}, as a new arrival. Your file number changes, and your phrase becomes six words.`;
    $('slip').innerHTML = `<p class="f-help" style="margin:0">${zh ? '摇一下签筒。' : 'Turn the drum once.'}</p>`;
  };
  $('drum').addEventListener('click', async () => {
    if (!v || v.home || turning) return;
    turning = true;
    const wheel = $('drum');
    wheel.classList.add('is-turning');
    audio.tune();
    const all = await homeBlocks(base).catch(() => null);
    await new Promise((r) => window.setTimeout(r, reducedMotion() ? 0 : 1500));
    turning = false;
    const got = all ? ballot(all, v.code, v.district) : null;
    if (!got) return void ($('slip').textContent = isZh() ? '签筒卡住了。等一下再摇。' : 'The drum is stuck. Try again in a moment.');
    v = { ...v, origin: v.origin ?? 'N', home: got.home, no: homeFileNo(v.code, got.home) };
    saveVisitor(v);
    keepOpened(fileNo(v));
    audio.stamp();
    markMe();
    card.classList.add('is-laminated');
    render();
    placeHome();
  });

  /* ---------- the block on the map ---------- */
  const placeHome = () => {
    if (!v?.home || !sm) return;
    const h = v.home;
    void sm.blocks().then(({ all }) => {
      const b = all.find((x) => x.postcode === h.postcode);
      if (!b) return;
      sm!.goto(b.x, b.y, 5000, { block: b.i });
      downstairs = b.fac.map((f) => [f.en, f.zh]);
      render();
    });
  };

  const flip = () => { card.classList.toggle('is-back'); audio.flick(); };
  card.addEventListener('click', flip);
  card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); } });

  const { base, markMe } = flat(() => { render(); sm?.relang(); });
  if (v?.home) {
    const pc = v.home.postcode;
    void homeBlocks(base).then((all) => { const b = all.find((x) => x.postcode === pc); if (b) { built = b.year || built; render(); } }).catch(() => {});
  }

  if (!v) {
    $('none').hidden = false;
  } else {
    const no = fileNo(v);
    const show = (arriving: boolean) => {
      $('file').hidden = false;
      if (arriving) $('file').classList.add('is-arriving');
      if (!sm) {
        sm = mountStreetMap($('home-map'), { base, home: v!.district });
        placeHome();
      }
    };
    // the first time, the file arrives sealed
    if (opened(no)) show(false);
    else
      void sealed(no, (el) => {
        el.no.textContent = no;
        el.sheetNo.textContent = no;
        el.code.textContent = v!.code;
        el.district.textContent = districtName(v!.district, isZh());
        el.to.textContent = v!.code;
        el.date.textContent = issued(v!.at);
      }).then(() => show(true));
    $('reseal').addEventListener('click', () => {
      reseal();
      audio.stamp();
      location.reload();
    });
    render();
    $('show-phrase').addEventListener('click', () => {
      const ol = $('me-phrase');
      ol.hidden = !ol.hidden;
      ol.innerHTML = toPhrase(v!).map((w) => `<li>${w}</li>`).join('');
      $('show-phrase').querySelector('span')!.textContent = ol.hidden ? t('Show phrase') : t('Hide phrase');
    });
    $('forget').addEventListener('click', () => {
      if (!window.confirm(t('Revise yourself out? Your card and your flat will be removed from this device. Keep your phrase if you want them back.'))) return;
      forgetVisitor();
      audio.stamp();
      location.reload();
    });
  }
</script>
