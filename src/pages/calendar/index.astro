---
// The calendar hangs on the office wall now, between the notice board and the screen.
const to = `${import.meta.env.BASE_URL}office/#calendar`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={`${import.meta.env.BASE_URL}office/`} />
    <title>The Ninth Draft</title>
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
  </head>
  <body><a href={to}>Office</a></body>
</html>
