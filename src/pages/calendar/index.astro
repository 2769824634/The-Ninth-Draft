---
import Flat from '../../layouts/Flat.astro';
import { loadRecords } from '../../lib/records';

const base = import.meta.env.BASE_URL;
const records = await loadRecords(base);

/** Every dated thing in the archive that falls in 1999: record dates, draft dates, attachment dates. */
const parse = (s?: string) => {
  const m = s?.match(/(\d{1,2})\.(\d{1,2})\.(\d{2})\b/);
  if (m) return `19${m[3]}-${m[2].padStart(2, '0')}-${m[1].padStart(2, '0')}`;
  const i = s?.match(/\b(\d{4})-(\d{2})-(\d{2})\b/);
  return i ? i[0] : null;
};
type Item = { day: string; file: string; slug: string; title: string; titleZh?: string; filed?: string; what: { en: string; zh: string } };
const items: Item[] = [];
for (const r of records) {
  const base_ = { file: r.file, slug: r.slug, title: r.title, titleZh: r.zh?.title, filed: r.date };
  const d = parse(r.date);
  if (d) items.push({ ...base_, day: d, what: { en: 'Record', zh: '档案' } });
  for (const k of r.drafts) {
    const dd = parse(k.date);
    if (dd) items.push({ ...base_, day: dd, what: { en: `Draft ${String(k.n).padStart(2, '0')}`, zh: `第 ${k.n} 稿` } });
  }
  for (const a of r.attachments) {
    const ad = parse(a.date);
    if (ad) items.push({ ...base_, day: ad, what: { en: 'Attachment', zh: '附件' } });
  }
}
const payload = JSON.stringify({ base, items }).replace(/</g, '\\u003c');
---

<Flat title="Calendar — The Ninth Draft" description="1999, month by month. Everything that happened on the island, and a great deal on the 9th." page="calendar">
  <p class="f-kicker micro"><b>Calendar</b><span>Records Office · 1999</span></p>
  <h1 class="f-title"><span data-l="en">Backflow calendar</span><span data-l="zh">回流年历</span></h1>
  <p class="f-lede">
    <span data-l="en">One year, twelve pages. Every record, draft and attachment with a date lands on its day. The 9th is marked in red. Nobody at the Office will say why.</span>
    <span data-l="zh">一年十二页。档案里凡是带日期的，都落在对应的那一天。9 号标红，署里没人肯说为什么。</span>
  </p>

  <div class="cal">
    <div class="cal__main">
      <div class="cal__bar">
        <button class="f-btn f-btn--ghost" type="button" id="cal-prev" aria-label="Previous month"><span>←</span></button>
        <h2 class="cal__month" id="cal-month" data-no-i18n>1999</h2>
        <button class="f-btn f-btn--ghost" type="button" id="cal-next" aria-label="Next month"><span>→</span></button>
      </div>
      <div class="cal__grid" id="cal-grid" role="grid" aria-label="Month"></div>
    </div>
    <aside class="cal__side">
      <div class="side__box" id="cal-day">
        <h3 id="cal-day-h">—</h3>
        <ul class="cal__list" id="cal-day-list"></ul>
      </div>
      <div class="side__box cal__clock">
        <h3>Office clock</h3>
        <p class="cal__time" id="cal-clock" data-no-i18n>--:--:--</p>
        <p class="micro" id="cal-clock-d" data-no-i18n>--.--.99</p>
      </div>
    </aside>
  </div>
</Flat>

<script type="application/json" id="cal-data" set:html={payload} />

<script>
  import { flat } from '../../app/flat';
  import { audio } from '../../app/audio';
  import { isZh, t } from '../../app/i18n';
  import { reducedMotion } from '../../app/prefs';
  import { hms, isFiled, islandNow } from '../../app/island';

  type Item = { day: string; file: string; slug: string; title: string; titleZh?: string; filed?: string; what: { en: string; zh: string } };
  const data = JSON.parse(document.getElementById('cal-data')!.textContent!) as { base: string; items: Item[] };
  // Only what has happened by the island's today: a record still to come is not on file yet
  data.items = data.items.filter((i) => isFiled(i.filed) && isFiled(i.day));
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const ZH = (n: number) => `${n + 1} 月`;
  const key = (m: number, d: number) => `1999-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;

  const now = islandNow();
  let month = now.month;
  let picked: number | null = now.day;

  const dayList = () => {
    const h = $('cal-day-h');
    const ul = $('cal-day-list');
    if (picked === null) {
      h.textContent = t('Pick a day');
      ul.innerHTML = '';
      return;
    }
    const zh = isZh();
    h.textContent = zh ? `1999 年 ${month + 1} 月 ${picked} 日` : `${picked} ${MONTHS[month]} 1999`;
    const here = data.items.filter((i) => i.day === key(month, picked!));
    ul.innerHTML = here.length
      ? here.map((i) => `<li><a href="${data.base}records/${i.slug}/"><b>${esc(i.file)}</b>${esc(zh ? i.titleZh ?? i.title : i.title)}</a><span class="micro">${esc(zh ? i.what.zh : i.what.en)}</span></li>`).join('') +
        `<li class="cal__paper"><a class="f-link" href="${data.base}library/#daily-${key(month, picked!)}">${esc(t('The Gerimis Daily for this day'))} →</a></li>`
      : `<li class="cal__none">${picked === 9 ? t('Nothing filed. The 9th is not blank, only unfiled.') : t('Nothing filed on this day.')}</li>` +
        `<li class="cal__paper"><a class="f-link" href="${data.base}library/#daily-${key(month, picked!)}">${esc(t('The Gerimis Daily for this day'))} →</a></li>`;
  };

  const draw = () => {
    const zh = isZh();
    $('cal-month').textContent = zh ? `1999 年 ${ZH(month)}` : `${MONTHS[month]} 1999`;
    const first = (new Date(Date.UTC(1999, month, 1)).getUTCDay() + 6) % 7; // Monday first
    const days = new Date(Date.UTC(1999, month + 1, 0)).getUTCDate();
    const heads = zh ? ['一', '二', '三', '四', '五', '六', '日'] : ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];
    const cells: string[] = heads.map((h) => `<span class="cal__h micro" role="columnheader">${h}</span>`);
    for (let i = 0; i < first; i++) cells.push('<span class="cal__x"></span>');
    for (let d = 1; d <= days; d++) {
      const n = data.items.filter((i) => i.day === key(month, d)).length;
      const cls = ['cal__d', d === 9 ? 'is-nine' : '', n ? 'has' : '', d === picked ? 'is-on' : '', month === now.month && d === now.day ? 'is-today' : ''].join(' ');
      cells.push(`<button type="button" class="${cls}" data-d="${d}" role="gridcell"><b>${d}</b>${n ? `<i>${'·'.repeat(Math.min(n, 4))}</i>` : ''}</button>`);
    }
    $('cal-grid').innerHTML = cells.join('');
    $('cal-grid').querySelectorAll<HTMLButtonElement>('.cal__d').forEach((b) =>
      b.addEventListener('click', () => {
        picked = Number(b.dataset.d);
        audio.click();
        draw();
      }),
    );
    dayList();
  };

  const step = (dir: number) => {
    month = (month + dir + 12) % 12;
    picked = null;
    audio.paper();
    const g = $('cal-grid');
    draw();
    if (!reducedMotion()) g.animate([{ opacity: 0, transform: `translateX(${dir * 14}px)` }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'ease-out' });
  };
  $('cal-prev').addEventListener('click', () => step(-1));
  $('cal-next').addEventListener('click', () => step(1));

  flat(draw);
  draw();

  // The Office clock keeps island time
  const tick = () => {
    const t = islandNow();
    $('cal-clock').textContent = hms(t.hours, t.minutes, t.seconds);
    $('cal-clock-d').textContent = `${String(t.day).padStart(2, '0')}.${String(t.month + 1).padStart(2, '0')}.99`;
  };
  tick();
  window.setInterval(tick, 1000);
</script>
