---
// The Daily is read in the library now: today's paper hangs on the rack.
const to = `${import.meta.env.BASE_URL}library/#daily-today`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={`${import.meta.env.BASE_URL}library/`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>The Ninth Draft</title>
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
  </head>
  <body><a href={to}>Library</a></body>
</html>
