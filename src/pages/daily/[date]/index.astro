---
// Old address of one issue: the library takes the paper off the rack and opens it on that day.
import { loadRecords } from '../../../lib/records';
import { buildIssues } from '../../../lib/daily';

export async function getStaticPaths() {
  const issues = buildIssues(await loadRecords(import.meta.env.BASE_URL));
  return issues.map((issue) => ({ params: { date: issue.date } }));
}
const to = `${import.meta.env.BASE_URL}library/#daily-${Astro.params.date}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={`${import.meta.env.BASE_URL}library/`} />
    <title>The Ninth Draft</title>
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
  </head>
  <body><a href={to}>Library</a></body>
</html>
