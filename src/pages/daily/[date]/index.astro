---
import Flat from '../../../layouts/Flat.astro';
import DailyIssue from '../../../components/DailyIssue.astro';
import { loadRecords } from '../../../lib/records';
import { buildIssues, longDate } from '../../../lib/daily';
import '../../../styles/daily.css';

export async function getStaticPaths() {
  const issues = buildIssues(await loadRecords(import.meta.env.BASE_URL));
  return issues.map((issue, i) => ({ params: { date: issue.date }, props: { issue, prev: issues[i + 1], next: issues[i - 1], all: issues } }));
}
const { issue, prev, next, all } = Astro.props;
---

<Flat title={`Gerimis Daily, ${longDate(issue.date).en} — The Ninth Draft`} description={issue.lead.head.en} page="daily">
  <DailyIssue issue={issue} prev={prev} next={next} all={all} />
</Flat>

<script>
  import { flat } from '../../../app/flat';
  flat();
</script>
