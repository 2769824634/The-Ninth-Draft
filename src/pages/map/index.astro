---
import Flat from '../../layouts/Flat.astro';
import { loadRecords } from '../../lib/records';
import { islandDay } from '../../app/island';
import { DISTRICTS, REGIONS } from '../../app/visitor/districts';
import StreetMap from '../../components/StreetMap.astro';
import { addressOf } from '../../lib/address';

const base = import.meta.env.BASE_URL;
const records = await loadRecords(base);
const inDistrict = (id: string) => records.filter((r) => r.district === id);
const unplaced = records.filter((r) => !r.district).length;
const KIND = {
  residential: { en: '', zh: '' },
  open: { en: 'No homes', zh: '无住户' },
  unsurveyed: { en: 'Not surveyed', zh: '未测绘' },
};
---

<Flat title="Map of Gerimis — The Ninth Draft" description="The fifty-two districts of Gerimis, with every record pinned where it happened." page="map">
  <p class="f-kicker micro"><b>Sheet 1 / 1</b><span>Records Office · Survey Section</span></p>
  <h1 class="f-title"><span data-l="en">Gerimis</span><span data-l="zh">霏微</span></h1>
  <p class="f-lede">
    <span data-l="en">One island, fifty-two districts, surveyed in 1999 and bound like the street directory in every glovebox. Drag it about, pinch or scroll to go closer: the towns, then the roads by name, then the blocks one by one. Red tags are records on file. The red dashes are the shore before the reclamation, which the Office would prefer you did not notice. Hatched ground is not surveyed.</span>
    <span data-l="zh">一座岛，五十二个区，1999 年测绘，装订得和每辆车里那本街道图一样。可以拖，可以两指或滚轮放大：先是镇，再是路名，最后一座座组屋。红色小标是在档的档案。红色虚线是填海以前的海岸，署方希望你没注意到。打斜线的地方是未测绘。</span>
  </p>

  <div class="map">
    <StreetMap id="smap" />

    <ol class="map__list" id="map-list">
      {REGIONS.map((g) => (
        <li class="map__grp is-open" data-r={g.id}>
          <button type="button" class="map__group micro" aria-expanded="true"><span><span data-l="en">{g.en}</span><span data-l="zh">{g.zh}</span></span><i>{DISTRICTS.filter((d) => d.region === g.id).length}</i></button>
          <ol class="map__sub">
          {DISTRICTS.filter((d) => d.region === g.id).map((d) => {
            const rs = inDistrict(d.id);
            const kind = KIND[d.kind];
            return (
              <li class={`map__item is-${d.kind}`} data-d={d.id}>
                <button type="button" aria-expanded="false">
                  <span class="map__item-name"><span data-l="en">{d.en}</span><span data-l="zh">{d.zh}</span></span>
                  <span class="micro">
                    <span class="map__you" hidden>You · </span>
                    {kind.en && <span class="map__kind"><span data-l="en">{kind.en}</span><span data-l="zh">{kind.zh}</span> · </span>}
                    <span data-island-count={`#map-list .map__item[data-d="${d.id}"] > ul > li[data-island-date]`}>{String(rs.length).padStart(2, '0')}</span>
                  </span>
                </button>
                <ul>
                  {rs.length ? (
                    rs.map((r) => {
                      const a = addressOf(r);
                      return (
                      <li data-island-date={islandDay(r.date) ?? ''} data-spot={a ? JSON.stringify({ file: r.file, title: [r.title, r.zh?.title ?? r.title], href: `${base}records/${r.slug}/`, x: a.x, y: a.y, addr: [a.en, a.zh], postcode: a.postcode }) : undefined}>
                        <a href={`${base}records/${r.slug}/`}><b>{r.file}</b><span data-l="en">{r.title}</span><span data-l="zh">{r.zh?.title ?? r.title}</span></a>
                      </li>
                      );
                    })
                  ) : null}
                  {(
                    <li class="map__empty" data-island-empty={`#map-list .map__item[data-d="${d.id}"] > ul > li[data-island-date]`}><span data-l="en">Nothing filed here yet.</span><span data-l="zh">这里还没有档案。</span></li>
                  )}
                </ul>
                <a class="map__more micro" href={`${base}district/${d.id}/`}><span>District file</span> →</a>
              </li>
            );
          })}
          </ol>
        </li>
      ))}
      {unplaced > 0 && <li class="micro" style="padding:.4rem .2rem">{unplaced} <span>not yet placed</span></li>}
    </ol>
  </div>

  <section class="gaz" id="index" aria-labelledby="gaz-h">
    <h2 class="f-sec__h" id="gaz-h"><i>A–Z</i><span><span data-l="en">Index of streets and places</span><span data-l="zh">地名索引</span></span></h2>
    <p class="f-help">
      <span data-l="en">The back pages of the directory: every road, station, river and neighbourhood on the sheet, A to Z, with its page and square. For a block, give its number and street, or its postcode. Choose a line and the sheet turns to it.</span>
      <span data-l="zh">街道图最后那几十页：图上每条路、每个车站、每条河和地名，按字母排，后面是页码和格号。找组屋就写座号和路名，或者邮编。点一行，图就翻到那里。</span>
    </p>
    <div class="gaz__find">
      <label class="micro" for="gaz-q"><span data-l="en">Look up</span><span data-l="zh">查找</span></label>
      <input class="f-input" id="gaz-q" type="search" autocomplete="off" spellcheck="false" placeholder="Lorong Lew Lian · Blk 7 Serangoon · 550007" />
    </div>
    <nav class="gaz__abc micro" id="gaz-abc" aria-label="Letters"></nav>
    <p class="gaz__head micro" id="gaz-head" aria-live="polite"><span data-l="en">Opening the index…</span><span data-l="zh">正在翻到索引……</span></p>
    <ol class="gaz__list" id="gaz-list"></ol>
  </section>
</Flat>

<script>
  import { flat } from '../../app/flat';
  import { audio } from '../../app/audio';
  import { t, isZh } from '../../app/i18n';
  import { reducedMotion } from '../../app/prefs';
  import { districtName } from '../../app/visitor/districts';
  import { loadVisitor } from '../../app/visitor/store';
  import { mountStreetMap, type RecordSpot } from '../../app/map/mount';
  import { mountGazetteer } from '../../app/map/gazetteer';

  const items = [...document.querySelectorAll<HTMLLIElement>('.map__item')];
  const groups = [...document.querySelectorAll<HTMLLIElement>('.map__grp')];
  const openGroup = (g: Element | null | undefined, yes: boolean) => {
    if (!g) return;
    g.classList.toggle('is-open', yes);
    g.querySelector('.map__group')!.setAttribute('aria-expanded', String(yes));
  };
  const v = loadVisitor();
  const wide = matchMedia('(min-width: 901px)');
  const { base } = flat(() => { sm.relang(); gaz.relang(); });

  // records already filed by the island's date, per district
  const pins = () => Object.fromEntries(items.map((li) => [li.dataset.d!, li.querySelectorAll('ul > li[data-island-date]:not([hidden])').length]));

  let on: string | null = null;
  const mark = (id: string | null, scroll: boolean) => {
    on = id;
    items.forEach((li) => {
      const yes = li.dataset.d === id;
      li.classList.toggle('is-on', yes);
      li.querySelector('button')!.setAttribute('aria-expanded', String(yes));
      if (yes) openGroup(li.closest('.map__grp'), true);
    });
    if (scroll && id && wide.matches) items.find((li) => li.dataset.d === id)?.scrollIntoView({ block: 'nearest', behavior: reducedMotion() ? 'auto' : 'smooth' });
  };

  const sm = mountStreetMap(document.getElementById('smap')!, {
    base,
    home: v?.district ?? null,
    pins,
    records: () => [...document.querySelectorAll<HTMLElement>('#map-list li[data-spot]:not([hidden])')].map((li) => JSON.parse(li.dataset.spot!) as RecordSpot),
    onPick: (id) => mark(id, true),
    idle: () => (v ? t('You live in {district}', { district: districtName(v.district, isZh()) }) : t('Drag the sheet')),
  });

  const gaz = mountGazetteer(document.getElementById('index')!, {
    base,
    go: (to) => {
      if (to.district) {
        mark(to.district, true);
        sm.pick(to.district);
      } else sm.goto(to.x, to.y, to.scale, { block: to.block, fac: to.fac });
      document.getElementById('smap')!.scrollIntoView({ block: 'start', behavior: reducedMotion() ? 'auto' : 'smooth' });
    },
    blocks: () => sm.blocks(),
  });

  if (v) items.find((li) => li.dataset.d === v.district)?.querySelector<HTMLElement>('.map__you')?.removeAttribute('hidden');
  items.forEach((li) =>
    li.querySelector('button')!.addEventListener('click', () => {
      const id = on === li.dataset.d ? null : li.dataset.d!;
      mark(id, false);
      sm.pick(id);
    }),
  );
  // on a phone the list folds into its five regions
  if (!wide.matches) groups.forEach((g) => openGroup(g, false));
  groups.forEach((g) => g.querySelector('.map__group')!.addEventListener('click', () => {
    openGroup(g, !g.classList.contains('is-open'));
    audio.click();
  }));
  if (v) mark(v.district, false);
</script>
