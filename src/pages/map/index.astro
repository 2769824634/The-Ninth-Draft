---
import Flat from '../../layouts/Flat.astro';
import { loadRecords } from '../../lib/records';
import { DISTRICTS } from '../../app/visitor/districts';

const base = import.meta.env.BASE_URL;
const records = await loadRecords(base);
const inDistrict = (id: string) => records.filter((r) => r.district === id);
const unplaced = records.filter((r) => !r.district).length;
const COLS = 'ABCDEFGHIJ';
// Drawn by hand: a wide island, a northern lobe, the core on the south shore
const COAST = 'M170 300C160 240 210 200 270 190C320 150 360 90 430 70C490 60 520 110 560 140C620 150 700 140 760 160C820 170 870 210 880 260C885 300 850 330 800 340C740 360 700 400 640 430C600 450 560 470 500 462C440 455 390 440 340 430C280 420 220 380 190 350Z';
const OLD = 'M330 404C400 412 460 420 520 410C580 400 620 385 690 362';
---

<Flat title="Map of Gerimis — The Ninth Draft" description="The seven districts of Gerimis, with every record pinned where it happened." page="map">
  <p class="f-kicker micro"><b>Sheet 1 / 1</b><span>Records Office · Survey Section</span></p>
  <h1 class="f-title"><span data-l="en">Gerimis</span><span data-l="zh">霏微</span></h1>
  <p class="f-lede">
    <span data-l="en">One island, seven districts. Each record is pinned to the district it was filed in. The red dashes are the old coastline, which the Office would prefer you did not notice.</span>
    <span data-l="zh">一座岛，七个区。每份档案钉在它归档的那个区。红色虚线是旧海岸线，署方希望你没注意到。</span>
  </p>

  <div class="map">
    <div class="map__frame">
      <svg class="map__svg" id="map" viewBox="0 0 1000 560" role="img" aria-label="Map of Gerimis">
        <defs>
          <linearGradient id="map-scan" x1="0" x2="1">
            <stop offset="0" stop-color="var(--accent)" stop-opacity="0" />
            <stop offset=".9" stop-color="var(--accent)" stop-opacity=".08" />
            <stop offset="1" stop-color="var(--accent)" stop-opacity=".22" />
          </linearGradient>
        </defs>
        <g class="map__grid" aria-hidden="true">
          {Array.from({ length: 9 }, (_, i) => <line x1={(i + 1) * 100} y1="0" x2={(i + 1) * 100} y2="560" />)}
          {Array.from({ length: 5 }, (_, i) => <line x1="0" y1={(i + 1) * 100} x2="1000" y2={(i + 1) * 100} />)}
          {Array.from({ length: 10 }, (_, i) => <text x={i * 100 + 8} y="18">{COLS[i]}</text>)}
          {Array.from({ length: 5 }, (_, i) => <text x="8" y={(i + 1) * 100 + 16}>{String(i + 2).padStart(2, '0')}</text>)}
        </g>
        <path class="map__sea" d={COAST} transform="translate(0 14) scale(1 1.03)" aria-hidden="true" />
        <path class="map__land" d={COAST} />
        <path class="map__old" d={OLD} aria-hidden="true" />
        <rect class="map__scan" id="map-scan" x="-160" y="0" width="160" height="560" aria-hidden="true" />
        {DISTRICTS.map((d) => {
          const n = inDistrict(d.id).length;
          return (
            <g class={`map__d${d.id === 'axis' ? ' is-axis' : ''}`} data-d={d.id} tabindex="0" role="button" aria-label={d.en}>
              <circle cx={d.x} cy={d.y} r={d.id === 'axis' ? 30 : 24} />
              <circle class="map__pin" cx={d.x} cy={d.y} r="3.5" />
              <text x={d.left ? d.x - 36 : d.x + 36} y={d.y - 4} text-anchor={d.left ? 'end' : 'start'}><tspan data-l="en">{d.en}</tspan><tspan data-l="zh" class="map__zh">{d.zh}</tspan></text>
              <text class="map__n" x={d.left ? d.x - 36 : d.x + 36} y={d.y + 13} text-anchor={d.left ? 'end' : 'start'}>{String(n).padStart(2, '0')} REC.</text>
            </g>
          );
        })}
      </svg>
      <span class="map__coord micro" id="map-coord">Hover a district</span>
    </div>

    <ol class="map__list" id="map-list">
      {DISTRICTS.map((d) => {
        const rs = inDistrict(d.id);
        return (
          <li class="map__item" data-d={d.id}>
            <button type="button" aria-expanded="false">
              <span class="map__item-name"><span data-l="en">{d.en}</span><span data-l="zh">{d.zh}</span></span>
              <span class="micro"><span class="map__you" hidden>You · </span>{String(rs.length).padStart(2, '0')}</span>
            </button>
            <ul>
              {rs.length ? (
                rs.map((r) => (
                  <li>
                    <a href={`${base}records/${r.slug}/`}><b>{r.file}</b><span data-l="en">{r.title}</span><span data-l="zh">{r.zh?.title ?? r.title}</span></a>
                  </li>
                ))
              ) : (
                <li class="map__empty"><span data-l="en">Nothing filed here yet.</span><span data-l="zh">这里还没有档案。</span></li>
              )}
            </ul>
          </li>
        );
      })}
      {unplaced > 0 && <li class="micro" style="padding:.4rem .2rem">{unplaced} <span>not yet placed</span></li>}
    </ol>
  </div>
</Flat>

<script>
  import { flat } from '../../app/flat';
  import { audio } from '../../app/audio';
  import { t, isZh } from '../../app/i18n';
  import { reducedMotion } from '../../app/prefs';
  import { DISTRICTS, districtName } from '../../app/visitor/districts';
  import { loadVisitor } from '../../app/visitor/store';

  const svg = document.getElementById('map') as unknown as SVGSVGElement;
  const coord = document.getElementById('map-coord')!;
  const items = [...document.querySelectorAll<HTMLLIElement>('.map__item')];
  const nodes = [...svg.querySelectorAll<SVGGElement>('.map__d')];
  const v = loadVisitor();
  let on: string | null = null;

  const grid = (id: string) => {
    const d = DISTRICTS.find((x) => x.id === id)!;
    return `${'ABCDEFGHIJ'[Math.floor(d.x / 100)]}-${String(Math.floor(d.y / 100) + 1).padStart(2, '0')}`;
  };
  const idle = () => (v ? t('You live in {district}', { district: districtName(v.district, isZh()) }) : t('Hover a district'));
  const select = (id: string | null, sound = true) => {
    on = id;
    nodes.forEach((n) => n.classList.toggle('is-on', n.dataset.d === id));
    items.forEach((li) => {
      const yes = li.dataset.d === id;
      li.classList.toggle('is-on', yes);
      li.querySelector('button')!.setAttribute('aria-expanded', String(yes));
    });
    coord.textContent = id ? `${t('Grid')} ${grid(id)} · ${districtName(id, isZh())}` : idle();
    if (sound && id) audio.click();
  };

  // The visitor's own district
  if (v) {
    const home = nodes.find((n) => n.dataset.d === v.district);
    const d = DISTRICTS.find((x) => x.id === v.district)!;
    if (home) {
      home.classList.add('is-home');
      const ns = 'http://www.w3.org/2000/svg';
      const ring = document.createElementNS(ns, 'circle');
      ring.setAttribute('class', 'map__home-ring');
      ring.setAttribute('cx', String(d.x));
      ring.setAttribute('cy', String(d.y));
      ring.setAttribute('r', '38');
      const tag = document.createElementNS(ns, 'text');
      tag.setAttribute('class', 'map__home');
      tag.setAttribute('x', String(d.x));
      tag.setAttribute('y', String(d.y + 60));
      tag.setAttribute('text-anchor', 'middle');
      tag.setAttribute('id', 'map-home');
      home.prepend(ring);
      home.append(tag);
    }
    items.find((li) => li.dataset.d === v.district)?.querySelector<HTMLElement>('.map__you')?.removeAttribute('hidden');
  }
  const relang = () => {
    const tag = document.getElementById('map-home');
    if (tag) tag.textContent = t('YOU LIVE HERE');
    select(on, false);
  };
  flat(relang);
  relang();

  nodes.forEach((n) => {
    n.addEventListener('mouseenter', () => select(n.dataset.d!, false));
    n.addEventListener('click', () => select(n.dataset.d!));
    n.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        select(n.dataset.d!);
      }
    });
  });
  items.forEach((li) => li.querySelector('button')!.addEventListener('click', () => select(on === li.dataset.d ? null : li.dataset.d!)));
  if (v) select(v.district, false);

  // A survey sweep crosses the sheet now and then
  if (!reducedMotion()) {
    const scan = document.getElementById('map-scan')!;
    scan.animate([{ transform: 'translateX(0)' }, { transform: 'translateX(1160px)' }], { duration: 5200, iterations: Infinity, easing: 'linear', delay: 600, endDelay: 3800 });
  }
</script>
