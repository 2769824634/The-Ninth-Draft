---
import Flat from '../../layouts/Flat.astro';
import '../../styles/idcard.css';

const base = import.meta.env.BASE_URL;
const arrow = '<svg viewBox="0 0 24 12" aria-hidden="true"><path d="M0 6h22M17 1l5 5-5 5" /></svg>';
---

<Flat title="Visitors' book — The Ninth Draft" description="Sign the visitors' book at the door of the Records Office and take a reader's pass. Residents register at Window 3." page="register">
  <div class="reg">
    <div>
      <p class="f-kicker micro"><b>Visitors' book</b><span>Records Office · Public Archive · Front desk</span></p>
      <h1 class="f-title"><span data-l="en">Sign in</span><span data-l="zh">入馆登记</span></h1>
      <p class="f-lede">
        <span data-l="en">Anyone may read here without signing. Sign the book and the desk gives you a reader's pass: the reading room writes your name on the slips, and the attendant stops calling you “the visitor”.</span>
        <span data-l="zh">不签名也能看。签了名，门口给你一张阅览证，资料室借书的单子上写你的名字，管理员也不用再叫你「那位访客」。</span>
      </p>

      <div class="desk">
        <div class="clerk" aria-live="polite">
          <p class="clerk__tag micro"><i></i><span>Attendant · Front desk</span></p>
          <p class="clerk__line" id="clerk-line"></p>
        </div>

        <form class="vbook" id="book" novalidate>
          <div class="vbook__head micro"><span id="book-date"></span><span id="book-page">Page 41</span></div>
          <div class="vbook__cols micro" aria-hidden="true"><span>No.</span><span>Name</span><span>From</span><span>Time</span></div>
          <ol id="book-rows"></ol>
          <div class="vbook__foot">
            <p><span data-l="en">Write it however you like. Nobody checks names at the door; the Office keeps what you write.</span><span data-l="zh">怎么写都行。门口不查名字，署里照你写的记。</span></p>
            <button class="f-btn" type="submit" id="sign"><span>Sign</span><Fragment set:html={arrow} /></button>
          </div>
          <p class="f-err" id="err" hidden></p>
        </form>

        <section class="stay" id="stay" hidden>
          <p class="f-kicker micro"><b>Window 3</b><span>Residents' Register · Form RO-9</span></p>
          <h2><span data-l="en">Staying on the island?</span><span data-l="zh">想在岛上住下？</span></h2>
          <p id="stay-text"></p>
          <div class="receipt__acts">
            <a class="f-btn" id="stay-go" href={`${base}register/resident/`}><span>Apply for residence</span><Fragment set:html={arrow} /></a>
            <a class="f-btn f-btn--ghost" href={`${base}library/`}><span>To the reading room</span></a>
          </div>
        </section>
      </div>
    </div>

    <aside class="side">
      <div class="rpass" id="pass" aria-label="Reader's pass"></div>
      <div class="side__box">
        <h3>Nothing leaves your browser</h3>
        <p><span data-l="en">The book and your pass are kept only on this device. No email, no password, no real names.</span><span data-l="zh">访客簿和阅览证只存在这台设备的浏览器里。不要邮箱，不要密码，不要真名。</span></p>
      </div>
      <div class="side__box" id="resign-box" hidden>
        <h3>Sign again</h3>
        <p><span data-l="en">A new line in the book and a new pass. The old one is crossed out.</span><span data-l="zh">在本子上另起一行，换一张新证。旧的那行划掉。</span></p>
        <button class="f-btn f-btn--ghost" type="button" id="resign"><span>Sign again</span></button>
      </div>
    </aside>
  </div>
</Flat>

<script>
  import { flat } from '../../app/flat';
  import { audio } from '../../app/audio';
  import { isZh, t } from '../../app/i18n';
  import { reducedMotion } from '../../app/prefs';
  import { hms, islandDateLabel, islandNow } from '../../app/island';
  import { DOOR, BOOK, type L } from '../../app/visitor/counter';
  import { passHTML } from '../../app/visitor/idcard';
  import { hash, loadPass, loadVisitor, savePass, forgetPass, type Pass } from '../../app/visitor/store';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const tx = (l: L) => (isZh() ? l.zh : l.en);
  const fill = (s: string, vars: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? '');
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const calm = reducedMotion();

  let pass: Pass | null = loadPass();
  const resident = loadVisitor();
  const draft = { code: resident?.code ?? '', from: resident?.from ?? '' };

  /* ---------- the attendant ---------- */
  const clerk = $('clerk-line');
  let last: [L, Record<string, string>] = [DOOR.greet, {}];
  let typing = 0;
  const say = (l: L, vars: Record<string, string> = {}, instant = false) => {
    last = [l, vars];
    const text = fill(tx(l), vars);
    window.clearInterval(typing);
    if (calm || instant) return void (clerk.textContent = text);
    clerk.textContent = '';
    let i = 0;
    typing = window.setInterval(() => {
      clerk.textContent = text.slice(0, ++i);
      if (i >= text.length) window.clearInterval(typing);
    }, isZh() ? 38 : 20);
  };

  /* ---------- the book: a few names before yours, the same for everyone today ---------- */
  const now = islandNow();
  const dayNo = now.month * 31 + now.day;
  const page = 41 + (dayNo % 300);
  const earlier = () => {
    const n = 4 + (hash(`book#${dayNo}`) % 3);
    const open = 9 * 60; // the doors open at nine
    const upTo = Math.max(open + 20, now.hours * 60 + now.minutes - 6);
    // a different name on every line: walk the list from a start and step of the day's own
    const start = hash(`book#${dayNo}`) >>> 3;
    return Array.from({ length: n }, (_, i) => {
      const [name, from] = BOOK[(start + i * 5) % BOOK.length];
      const m = open + Math.floor(((i + 0.5) / n) * (upTo - open));
      return { name, from, time: hms(Math.floor(m / 60) % 24, m % 60) };
    });
  };
  const rowsEl = $('book-rows');
  let react = 0;
  const timeOf = (ms: number) => { const d = islandNow(ms); return hms(d.hours, d.minutes); };
  const renderBook = (justSigned = false) => {
    const zh = isZh();
    $('book-date').textContent = `${t("Visitors' book")} · ${islandDateLabel(zh)}`;
    $('book-page').textContent = zh ? `第 ${page} 页` : `Page ${page}`;
    const list = earlier();
    const rows = list.map((r, i) => `<li class="vbook__row"><i>${String(i + 1).padStart(2, '0')}</i><b>${esc(r.name)}</b><span>${esc(tx(r.from))}</span><time>${r.time}</time></li>`);
    const n = String(list.length + 1).padStart(2, '0');
    if (pass) {
      rows.push(`<li class="vbook__row is-you${justSigned ? ' is-signed' : ''}"><i>${n}</i><b>${esc(pass.code)}</b><span>${esc(pass.from ?? '')}</span><time>${timeOf(pass.at)}</time></li>`);
    } else {
      rows.push(`<li class="vbook__row is-you"><i>${n}</i>
        <input class="f-input" id="b-code" maxlength="24" autocomplete="off" spellcheck="false" value="${esc(draft.code)}" placeholder="${zh ? '名字' : 'Name'}" aria-label="${zh ? '名字' : 'Name'}" />
        <input class="f-input" id="b-from" maxlength="32" autocomplete="off" spellcheck="false" value="${esc(draft.from)}" placeholder="${zh ? '从哪来（选填）' : 'From (optional)'}" aria-label="${zh ? '从哪来' : 'From'}" />
        <time>${hms(now.hours, now.minutes)}</time></li>`);
    }
    rowsEl.innerHTML = rows.join('');
    $('sign').hidden = !!pass;
    if (pass) return;
    const code = $<HTMLInputElement>('b-code'), from = $<HTMLInputElement>('b-from');
    code.addEventListener('input', () => {
      draft.code = code.value;
      renderPass();
      window.clearTimeout(react);
      react = window.setTimeout(() => (draft.code.trim() ? say(DOOR.name, { name: draft.code.trim() }) : say(DOOR.empty)), 600);
    });
    from.addEventListener('input', () => { draft.from = from.value; renderPass(); });
  };

  /* ---------- the pass ---------- */
  const passEl = $('pass');
  const renderPass = () => {
    passEl.innerHTML = passHTML(pass ?? { code: draft.code, from: draft.from }, isZh()) + '<span class="fstamp" id="pstamp" aria-hidden="true">ADMITTED</span>';
    if (pass) passEl.querySelector('#pstamp')!.classList.add('is-down');
  };

  const renderStay = () => {
    const zh = isZh();
    $('stay').hidden = !pass && !resident;
    $('resign-box').hidden = !pass;
    const go = $<HTMLAnchorElement>('stay-go');
    if (resident) {
      $('stay-text').textContent = zh ? `你已经是岛上的居民了，档案 ${resident.no ? `V-${String(resident.no).padStart(4, '0')}` : ''}。` : `You are already on the residents' register, file V-${String(resident.no).padStart(4, '0')}.`;
      go.href = go.href.replace(/register\/resident\/$/, 'me/');
      go.querySelector('span')!.textContent = t('Go home');
    } else {
      $('stay-text').textContent = zh ? '居民有屋子、身份证和一个信箱。填 RO-9 表要几分钟，先在机器上取个号。' : 'Residents get a flat, a card and a letterbox. Form RO-9 takes a few minutes, and a number from the machine.';
    }
  };

  const { markMe } = flat(() => {
    renderBook();
    renderPass();
    renderStay();
    say(last[0], last[1], true);
  });

  const err = $('err');
  $('book').addEventListener('submit', (e) => {
    e.preventDefault();
    if (pass) return;
    const code = draft.code.trim();
    if (!code) {
      err.textContent = isZh() ? '名字必填。' : 'A name is required.';
      err.hidden = false;
      audio.click();
      return say(DOOR.empty);
    }
    err.hidden = true;
    window.clearTimeout(react);
    pass = { no: 100 + Math.floor(Math.random() * 3996), code, ...(draft.from.trim() ? { from: draft.from.trim().slice(0, 32) } : {}), at: Date.now() };
    savePass(pass);
    audio.stamp();
    renderBook(true);
    renderPass();
    renderStay();
    markMe();
    say(DOOR.signed);
    window.setTimeout(() => say(DOOR.stay), calm ? 0 : 3200);
    if (!calm) passEl.animate([{ transform: 'translateY(-8px) rotate(-2deg)', opacity: 0.4 }, { transform: 'none', opacity: 1 }], { duration: 480, easing: 'cubic-bezier(.3,1.4,.5,1)' });
  });

  $('resign').addEventListener('click', () => {
    if (pass) Object.assign(draft, { code: pass.code, from: pass.from ?? '' });
    pass = null;
    forgetPass();
    audio.paper();
    renderBook();
    renderPass();
    renderStay();
    markMe();
    say(DOOR.greet);
    if (!matchMedia('(pointer: coarse)').matches) $<HTMLInputElement>('b-code').focus();
  });

  renderBook();
  renderPass();
  renderStay();
  say(pass ? DOOR.back : DOOR.greet, {}, true);
</script>
