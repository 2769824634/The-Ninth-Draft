---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Revised out — The Ninth Draft" description="This page has been revised out.">
  <main class="gone">
    <Seal />
    <p class="gone__no micro">Records Office · Gerimis · Error 404</p>
    <h1 class="gone__title"><span class="gone__old">This page exists.</span> This page has been revised out.</h1>
    <p class="gone__zh">此页已被修订掉。如有不同，是上一稿。</p>
    <p class="gone__note">If you remember it being here, that is a backflow. Please do not report it.</p>
    <a class="gone__back micro" href={base}>Return to the archive →</a>
  </main>
</Base>

<style>
  .gone {
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: start;
    gap: 1.1rem;
    padding: 2rem 1rem;
    max-width: 40rem;
    margin: 0 auto;
    background: var(--bg);
    color: var(--ink);
  }
  /* the seal's own styles live with the boot overlay, which this page does not load */
  .gone :global(.seal) { width: 7rem; height: 7rem; overflow: visible; opacity: .85; }
  .gone :global(.seal__draw) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: gone-draw 1.6s var(--ease-io) forwards;
  }
  .gone :global(.seal__thin) { stroke-width: .9; animation-delay: .25s; }
  .gone :global(.seal__orbit) { stroke: var(--accent); stroke-width: 1.4; animation-delay: .7s; }
  .gone :global(.seal__text) { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: 3.1px; fill: var(--ink); }
  .gone :global(.seal__nine) { font-family: var(--f-sans); font-weight: 800; font-stretch: 112%; font-size: 76px; fill: var(--ink); }
  .gone :global(.seal__sat) { display: none; }
  @keyframes gone-draw { to { stroke-dashoffset: 0; } }
  .gone__no { color: var(--ink-3); }
  .gone__title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 5vw, 2.6rem);
    line-height: 1.08;
    text-transform: uppercase;
  }
  .gone__old {
    display: block;
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    animation: gone-strike 2.4s var(--ease) both;
  }
  @keyframes gone-strike {
    0%, 30% { opacity: 1; text-decoration-color: transparent; }
    60% { text-decoration-color: var(--accent); }
    100% { opacity: .55; text-decoration-color: var(--accent); }
  }
  .gone__zh { margin: 0; font-family: var(--f-serif); font-size: 1.1rem; }
  .gone__note { margin: 0; font-family: var(--f-serif); color: var(--ink-2); }
  .gone__back { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--accent); padding-bottom: .15rem; }
  @media (prefers-reduced-motion: reduce) {
    .gone__old { animation: none; opacity: .55; }
    .gone :global(.seal__draw) { animation: none; stroke-dashoffset: 0; }
  }
</style>
