---
import Flat from '../../layouts/Flat.astro';
import { loadRecords } from '../../lib/records';
import { buildLibrary } from '../../lib/library';
import '../../styles/library.css';

const base = import.meta.env.BASE_URL;
const bays = buildLibrary(await loadRecords(base), base);
---

<Flat title="Library — The Ninth Draft" description="The Records Office library: the Daily bound by month, the district gazetteers, the bound records, and the Office's own publications." page="library">
  <div class="lib" id="lib" data-state="shelf">
    <canvas class="lib__canvas" id="lib-canvas" aria-hidden="true"></canvas>

    <div class="lib__head">
      <p class="f-kicker micro"><b>Room 03</b><span><span data-l="en">Records Office · Library · Open stacks</span><span data-l="zh">记录署 · 资料室 · 开架</span></span></p>
      <h1 class="lib__title"><span data-l="en">Library</span><span data-l="zh">资料室</span></h1>
      <nav class="lib__bays" aria-label="Bays" id="lib-bays">
        {bays.map((b, i) => (
          <button type="button" data-bay={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            <i class="micro">{b.code}</i>
            <span data-l="en">{b.title.en}</span><span data-l="zh">{b.title.zh}</span>
          </button>
        ))}
      </nav>
    </div>

    <ol class="lib__shelf" id="lib-shelf" aria-label="Books on this bay"></ol>

    <p class="lib__callout micro" id="lib-callout" aria-hidden="true"></p>

    <div class="lib__foot">
      <p class="voice" id="voice" aria-live="polite"><span class="voice__who"><i></i>Archivist</span><span class="voice__line" id="voice-line"></span></p>
      <p class="lib__hints micro" id="lib-hints">
        <span data-l="en"><kbd>←</kbd><kbd>→</kbd> walk the stacks · click a spine to take it down</span>
        <span data-l="zh"><kbd>←</kbd><kbd>→</kbd> 沿书架走 · 点书脊把书取下来</span>
      </p>
    </div>

    <aside class="lib-reader" id="lib-reader" aria-hidden="true" aria-label="Reader">
      <header class="lib-reader__top">
        <span class="micro" id="rd-mark"></span>
        <button type="button" class="lib-reader__close micro" id="rd-close"><span data-l="en">Return to shelf</span><span data-l="zh">放回书架</span> <span class="kbd">Esc</span></button>
      </header>
      <p class="lib-reader__book micro" id="rd-book"></p>
      <div class="lib-reader__page" id="rd-page">
        <h2 class="lib-reader__head" id="rd-head"></h2>
        <div class="lib-reader__body" id="rd-body"></div>
      </div>
      <footer class="lib-reader__nav">
        <button type="button" id="rd-prev" aria-label="Previous page">←</button>
        <span class="micro" id="rd-no"></span>
        <button type="button" id="rd-next" aria-label="Next page">→</button>
      </footer>
    </aside>
  </div>

  <script type="application/json" id="lib-data" set:html={JSON.stringify(bays).replace(/</g, "\\u003c")} />
</Flat>

<script>
  import { library } from '../../app/library/main';
  library();
</script>
