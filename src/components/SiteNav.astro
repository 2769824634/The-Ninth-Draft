---
/**
 * The one page navigation, shared by the archive room and every flat page,
 * so the site reads as one building with the same signs in every corridor.
 */
export type NavId = 'archive' | 'links' | 'library' | 'office' | 'map' | 'calendar' | 'daily' | 'guide';

interface Props {
  current?: NavId | null;
  /** The archive room shows its second view, the red-string wall, beside it. */
  wall?: boolean;
}
const { current = null, wall = false } = Astro.props;
const base = import.meta.env.BASE_URL;
// Three rooms and the map. The Daily lives on the library's rack, the
// calendar on the office wall; the guide sits with Register, top right.
const items: { id: NavId; href: string; label: string; key?: string }[] = [
  { id: 'archive', href: base, label: 'Archive' },
  ...(wall ? [{ id: 'links' as const, href: `${base}wall/`, label: 'Links', key: 'W' }] : []),
  { id: 'library', href: `${base}library/`, label: 'Library' },
  { id: 'office', href: `${base}office/`, label: 'Office' },
  { id: 'map', href: `${base}map/`, label: 'Map' },
];
---

<nav class="sitenav micro" aria-label="Pages">
  {items.map((n) => (
    <a href={n.href} id={`nav-${n.id}`} data-nav={n.id} aria-current={n.id === current ? 'page' : undefined}>
      <span>{n.label}</span>
    </a>
  ))}
</nav>
