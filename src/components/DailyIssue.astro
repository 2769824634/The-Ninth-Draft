---
/**
 * One issue of the Gerimis Daily. Both languages are printed; the page shows one.
 */
import { longDate, type Issue, type Story } from '../lib/daily';

interface Props {
  issue: Issue;
  prev?: Issue;
  next?: Issue;
  all: Issue[];
}
const { issue, prev, next, all } = Astro.props;
const base = import.meta.env.BASE_URL;
const ld = longDate(issue.date);
const fileLink = (s: Story) => (s.slug ? `${base}records/${s.slug}/` : null);
const byMonth = new Map<string, Issue[]>();
for (const i of [...all].reverse()) {
  const k = i.date.slice(0, 7);
  if (!byMonth.has(k)) byMonth.set(k, []);
  byMonth.get(k)!.push(i);
}
const monthLabel = (k: string) => {
  const [y, m] = k.split('-').map(Number);
  return { en: `${['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'][m - 1]} ${y}`, zh: `${y} 年 ${m} 月` };
};
---

<article class="paper paper--unprinted" data-island-until={issue.date} hidden>
  <p class="micro"><span data-l="en">The Gerimis Daily</span><span data-l="zh">霏微日报</span> · <span data-l="en">{ld.en}</span><span data-l="zh">{ld.zh}</span></p>
  <p><span data-l="en">This issue has not gone to press yet.</span><span data-l="zh">这一期还没付印。</span></p>
</article>

<article class="paper" data-special={issue.special ? 'yes' : undefined} data-island-date={issue.date}>
  <header class="paper__mast">
    <div class="paper__ear micro">
      <span><span data-l="en">Est. 1946</span><span data-l="zh">创刊于 1946 年</span></span>
      <span><span data-l="en">Late edition</span><span data-l="zh">晚报版</span></span>
      <span><span data-l="en">20 cents</span><span data-l="zh">每份二角</span></span>
    </div>
    <h1 class="paper__name"><span data-l="en">The Gerimis Daily</span><span data-l="zh">霏微日报</span></h1>
    <div class="paper__line micro">
      <span><span data-l="en">{ld.en}</span><span data-l="zh">{ld.zh}</span></span>
      <span>No. {String(issue.no).padStart(3, '0')}</span>
      <span><span data-l="en">{issue.weather.en}</span><span data-l="zh">{issue.weather.zh}</span></span>
    </div>
  </header>

  <div class="paper__grid">
    <section class="paper__lead">
      {issue.lead.stamp && <span class="paper__kicker micro"><span data-l="en">Front page</span><span data-l="zh">头版</span> · {issue.lead.file}</span>}
      <h2 class="paper__head"><span data-l="en">{issue.lead.head.en}</span><span data-l="zh">{issue.lead.head.zh}</span></h2>
      {!issue.quiet && <figure class="paper__photo" aria-hidden="true">
        <div class="paper__halftone"></div>
        <figcaption class="micro"><span data-l="en">Photograph: Records Office. Some details have been removed.</span><span data-l="zh">图片：记录署。部分细节已删除。</span></figcaption>
      </figure>}
      <div class="paper__copy paper__copy--lead">
        <p><span data-l="en" set:html={issue.lead.body.en} /><span data-l="zh" set:html={issue.lead.body.zh} /></p>
      </div>
      {fileLink(issue.lead) && <a class="paper__file f-link" href={fileLink(issue.lead)!}><span data-l="en">Read the file</span><span data-l="zh">查看档案</span> {issue.lead.file} →</a>}
    </section>

    <aside class="paper__side">
      <section class="paper__box">
        <h3 class="paper__boxh"><span data-l="en">Corrections</span><span data-l="zh">更正</span></h3>
        {issue.corrections.length ? issue.corrections.map((c) => (
          <p class="paper__small"><b>{c.file}</b> <span data-l="en">{c.body.en}</span><span data-l="zh">{c.body.zh}</span></p>
        )) : <p class="paper__small paper__none"><span data-l="en">No corrections today. The Office regards this as a correction in itself.</span><span data-l="zh">今日无更正。署里认为，这本身就是一种更正。</span></p>}
      </section>
      {issue.notices.length > 0 && (
        <section class="paper__box">
          <h3 class="paper__boxh"><span data-l="en">From the files</span><span data-l="zh">档案摘录</span></h3>
          {issue.notices.map((n) => (
            <p class="paper__small"><a href={fileLink(n)!}><b><span data-l="en">{n.head.en}</span><span data-l="zh">{n.head.zh}</span></b></a> <span data-l="en">{n.body.en}</span><span data-l="zh">{n.body.zh}</span></p>
          ))}
        </section>
      )}
      <section class="paper__box paper__box--office">
        <h3 class="paper__boxh"><span data-l="en">Records Office</span><span data-l="zh">记录署</span></h3>
        <p class="paper__small"><span data-l="en">{issue.office.en}</span><span data-l="zh">{issue.office.zh}</span></p>
      </section>
    </aside>

    {issue.articles.length > 0 && (
      <section class="paper__more">
        {issue.articles.map((a) => (
          <div class="paper__art">
            {a.page && <span class="paper__kicker micro">{a.page}</span>}
            <h3 class="paper__subhead"><span data-l="en">{a.head.en}</span><span data-l="zh">{a.head.zh}</span></h3>
            <p class="paper__copy"><span data-l="en" set:html={a.body.en} /><span data-l="zh" set:html={a.body.zh} /></p>
            {fileLink(a) && <a class="paper__file f-link" href={fileLink(a)!}>{a.file} →</a>}
          </div>
        ))}
      </section>
    )}

    <section class="paper__foot">
      <div class="paper__box">
        <h3 class="paper__boxh"><span data-l="en">Classified</span><span data-l="zh">分类广告</span></h3>
        {issue.classifieds.map((c) => <p class="paper__small paper__ad"><span data-l="en">{c.en}</span><span data-l="zh">{c.zh}</span></p>)}
      </div>
      <div class="paper__box">
        <h3 class="paper__boxh"><span data-l="en">Tides &amp; clocks</span><span data-l="zh">潮汐与钟点</span></h3>
        <p class="paper__small"><span data-l="en">{issue.tide.en}</span><span data-l="zh">{issue.tide.zh}</span></p>
        <p class="paper__small"><span data-l="en">Axis 12:00 · Silva 13:00 · Portus Posterior 11:00. The Time office is aware.</span><span data-l="zh">中枢 12:00 · 林地 13:00 · 后港 11:00。时间科已知悉。</span></p>
      </div>
    </section>
  </div>
</article>

<nav class="papernav" aria-label="Issues">
  {prev ? <a class="f-btn f-btn--ghost" href={`${base}daily/${prev.date}/`}><span>← <span data-l="en">{longDate(prev.date).en}</span><span data-l="zh">{longDate(prev.date).zh}</span></span></a> : <span></span>}
  {next ? <a class="f-btn f-btn--ghost" href={`${base}daily/${next.date}/`} data-island-date={next.date}><span><span data-l="en">{longDate(next.date).en}</span><span data-l="zh">{longDate(next.date).zh}</span> →</span></a> : <span></span>}
</nav>

<section class="f-sec papers">
  <h2 class="f-sec__h"><i data-island-count=".papers li[data-island-date]">{String(all.length).padStart(2, '0')}</i><span>Back issues</span></h2>
  <p class="f-help papers__key"><span data-l="en">Bold days carry news from the files. The rest are ordinary days, which the island also has.</span><span data-l="zh">加粗的日子有档案里的新闻。其余是平常日子，岛上也有平常日子。</span></p>
  <div class="papers__months">
    {[...byMonth.entries()].reverse().map(([k, list]) => (
      <div class:list={['papers__month', { 'papers__month--loose': list.length < 28 }]} data-island-date={`${k}-01`}>
        <h3 class="micro"><span data-l="en">{monthLabel(k).en}</span><span data-l="zh">{monthLabel(k).zh}</span></h3>
        <ul>
          {list.length >= 28 && ['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d, j) => <li class="is-dow micro" aria-hidden="true"><span data-l="en">{d}</span><span data-l="zh">{'一二三四五六日'[j]}</span></li>)}
          {list.length >= 28 && Array.from({ length: (new Date(Date.UTC(Number(k.slice(0, 4)), Number(k.slice(5, 7)) - 1, 1)).getUTCDay() + 6) % 7 }, () => <li class="is-pad" aria-hidden="true"></li>)}
          {list.map((i) => (
            <li class:list={[{ 'is-on': i.date === issue.date, 'is-nine': i.date.endsWith('-09'), 'is-news': !i.quiet }]} data-island-date={i.date}>
              <a href={`${base}daily/${i.date}/`} title={i.lead.head.en}><b>{Number(i.date.slice(8))}</b></a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
