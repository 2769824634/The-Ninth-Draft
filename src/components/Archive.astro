---
import { CATEGORIES, type ClientRecord } from '../lib/records';
import Seal from './Seal.astro';
import SiteNav from './SiteNav.astro';
import archivist from '../data/archivist.json';
import '../styles/hud.css';
import '../styles/dossier.css';
import '../styles/overlays.css';
import '../styles/wall.css';
import '../styles/quirks.css';
import '../styles/attach.css';
import '../styles/system.css';
import '../styles/zh.css';
import '../styles/stacks.css';

interface Props {
  records: ClientRecord[];
  initial?: string;
  room?: 'archive' | 'wall';
}
const { records, initial, room = 'archive' } = Astro.props;
const base = import.meta.env.BASE_URL;
const payload = JSON.stringify({ base, categories: CATEGORIES, records, archivist, initial: initial ?? null, room }).replace(/</g, '\\u003c');
// One string per pair of files, whichever side names the other
// Programs chapter page: what the drawer holds, and the years it spans
const programsNo = String(CATEGORIES.findIndex((c) => c.id === 'programs') + 1).padStart(2, '0');
const programs = records.filter((r) => r.category === 'programs');
const years = programs.flatMap((r) => (r.date ?? '').match(/\d{4}/g) ?? []).map(Number);
const span = years.length ? `${Math.min(...years)} — ${Math.max(...years)}` : '';
const stackZones = [
  { id: 'overview', en: 'The whole room', zh: '整间档案库' },
  { id: 'formal', en: 'Formal records', zh: '正式档案' },
  { id: 'routine', en: 'Routine paperwork', zh: '例行文件' },
  { id: 'reading', en: 'Reading table', zh: '阅档桌' },
  { id: 'counter', en: 'Intake desk', zh: '入库台' },
  { id: 'door', en: 'Door and switches', zh: '门口和开关' },
];
const links = new Set(records.flatMap((r) => r.related.filter((f) => records.some((x) => x.file === f)).map((f) => [r.file, f].sort().join('|')))).size;
---

<div class="archive" id="archive" data-view="browse" data-boot="on" data-room={room} data-readat="drawer">
  <canvas class="wall" id="wall" aria-hidden="true"></canvas>
  <canvas class="stacks" id="stacks" aria-hidden="true"></canvas>
  <div class="veil" aria-hidden="true"></div>

  <!-- ===================== HUD ===================== -->
  <header class="brand">
    <a class="brand__link" href={base} data-nav="home" aria-label="Public Archive — overview">
      <span class="brand__l1">Gerimis Records Office</span>
      <span class="brand__l2">Public Archive</span>
    </a>
  </header>

  <SiteNav current={room === 'wall' ? 'links' : 'archive'} wall />

  <nav class="tools" aria-label="Tools">
    <a class="tool" id="btn-me" href={`${base}register/`}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="3" width="13" height="10" /><circle cx="5.6" cy="7.2" r="1.6" /><path d="M3.2 11c.5-1.3 1.3-1.9 2.4-1.9s1.9.6 2.4 1.9M9.8 6.6h3M9.8 8.8h2.2" /></svg>
      <span id="me-label">Register</span>
    </a>
    <a class="tool" id="nav-guide" href={`${base}guide/`}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2.5h7.5l2.5 2.5v8.5H3z" /><path d="M5.5 7h5M5.5 9.5h5M5.5 12h3" /></svg>
      <span>Guide</span>
    </a>
    <button class="tool" id="btn-search" type="button">
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.6" /><path d="M10.4 10.4 14 14" /></svg>
      <span>Index</span><span class="kbd">/</span>
    </button>
    <div class="seg" role="group" aria-label="Lighting">
      <span class="seg__thumb" aria-hidden="true"></span>
      <button type="button" data-theme-set="day" aria-pressed="true">Day</button>
      <button type="button" data-theme-set="night" aria-pressed="false">Night</button>
    </div>
    <button class="tool tool--lang" id="btn-lang" type="button" aria-label="Language">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <rect class="pg pg--a" x="2" y="1.5" width="8" height="10" />
        <g class="pg pg--b"><rect x="6" y="4.5" width="8" height="10" /><path d="M8 8h4M8 10.5h2.6" /></g>
      </svg>
      <span class="lang__pair" aria-hidden="true"><b lang="en">EN</b><i>/</i><b lang="zh-CN">中</b></span><span class="kbd">L</span>
    </button>
    <button class="tool tool--sound" id="btn-sound" type="button" aria-pressed="false">
      <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span id="sound-label">Sound off</span>
    </button>
  </nav>

  <!-- SYSTEM: the archive's machine voice, cold and occasional -->
  <div class="sysmsg" id="sysmsg" role="status" aria-live="polite">
    <span class="sysmsg__tag">System</span>
    <span class="sysmsg__line" id="sysmsg-line"></span>
    <span class="sysmsg__wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
  </div>

  <footer class="foot">
    <p class="voice" id="voice" aria-live="polite"><span class="voice__who"><i></i>Archivist</span><span class="voice__line" id="voice-line">Come in.</span></p>
    <span class="foot__coords micro" id="coords">RA 04h 21m 07s · Dec +61° 12′</span>
    <span class="foot__year micro" id="year" data-no-i18n>1999</span>
    <span class="foot__clock micro" id="clock" data-no-i18n>00:00:00</span>
    <span class="foot__mark"><b>Gerimis</b> <span>Records Office</span><i></i></span>
  </footer>

  <!-- ===================== DOSSIER ===================== -->
  <aside class="inspect" aria-hidden="true">
    <button class="back" id="btn-back" type="button">
      <svg viewBox="0 0 24 12" aria-hidden="true"><path d="M24 6H2M7 1 2 6l5 5" /></svg>
      <span>Archive overview</span><span class="kbd">Esc</span>
    </button>
    <!-- what the archivist says while a file is open: a slip in the margin -->
    <div class="dsv" id="ds-voice" aria-live="polite" data-no-i18n>
      <button type="button" class="dsv__tag" id="ds-voice-tag" aria-expanded="false"><i></i>Archivist</button>
      <div class="dsv__slip">
        <p class="dsv__now" id="ds-voice-now"></p>
        <ol class="dsv__was" id="ds-voice-was"></ol>
      </div>
      <div class="dsv__switches" id="ds-switches" hidden>
        <span class="micro"><span data-l="en">Lights here</span><span data-l="zh">这里的灯</span></span>
        <button type="button" data-ls="exam" aria-pressed="false"><i></i><span data-l="en">Swing-arm lamp</span><span data-l="zh">摇臂灯</span></button>
        <button type="button" data-ls="row" aria-pressed="false"><i></i><span data-l="en">Pendants overhead</span><span data-l="zh">头顶吊灯</span></button>
        <button type="button" data-ls="desks" aria-pressed="false"><i></i><span data-l="en">Reading lamp</span><span data-l="zh">阅读灯</span></button>
        <button type="button" data-ls="seat" aria-pressed="false"><i></i><span data-l="en">Sit at the right</span><span data-l="zh">坐右边</span></button>
      </div>
    </div>
    <div class="inspect__no">
      <span class="inspect__big" id="in-no">No.0001</span>
      <span class="micro" id="in-cat">Personnel / Internal archive</span>
    </div>
  </aside>

  <div class="watermark" id="watermark" aria-hidden="true">0001</div>


  <!-- ===================== THE STACKS (the room you walk into) ===================== -->
  <section class="stackshud" id="stackshud" aria-label="The stacks" data-no-i18n>
    <div class="stackshud__head">
      <p class="stackshud__kicker micro"><span data-l="en">Room 01 / Ground floor · Archive</span><span data-l="zh">01 室 / 一楼 · 档案库</span></p>
      <h1 class="stackshud__title"><span data-l="en">The stacks</span><span data-l="zh">档案库</span></h1>
      <p class="stackshud__stats micro" id="stacks-stats" data-no-i18n></p>
      <nav class="stackshud__zones" id="stacks-zones" aria-label="Corners of the room">
        {stackZones.map((z, i) => (
          <button type="button" data-zone={z.id} aria-pressed={i === 0 ? 'true' : 'false'}><i>{String(i).padStart(2, '0')}</i><span data-l="en">{z.en}</span><span data-l="zh">{z.zh}</span></button>
        ))}
      </nav>
      <div class="stackshud__cats" id="stacks-cats">
        <p class="micro"><span data-l="en">Formal records · open a cabinet</span><span data-l="zh">正式档案 · 拉开柜子</span></p>
        {CATEGORIES.map((c, i) => (
          <button type="button" data-cat={i}><i>{c.code}</i><span data-l="en">{c.label}</span><span data-l="zh">{({ personnel: '人员', events: '事件', programs: '计划' } as Record<string, string>)[c.id]}</span><b class="micro" data-count={c.id} data-no-i18n></b></button>
        ))}
      </div>
      <div class="stackshud__lights" role="group" aria-label="Light switches by the door">
        <p class="micro"><span data-l="en">Switches by the door</span><span data-l="zh">门边的开关</span></p>
        <div class="stackshud__rockers">
          {[0, 1, 2, 3].map((i) => (
            <button type="button" data-row={i} aria-pressed="false"><b>{i + 1}</b><span data-l="en">{['Door', 'Formal', 'Routine', 'Reading'][i]}</span><span data-l="zh">{['门口', '正式', '例行', '阅档'][i]}</span></button>
          ))}
        </div>
        <div class="stackshud__desks">
          {[0, 1, 2].map((i) => (
            <button type="button" data-desk={i} aria-pressed="false"><i></i><span data-l="en">{['Reading lamp 1', 'Reading lamp 2', 'Intake lamp'][i]}</span><span data-l="zh">{['阅档台灯 1', '阅档台灯 2', '入库台灯'][i]}</span></button>
          ))}
        </div>
      </div>
      <div class="stackshud__panel" id="stacks-table"></div>
      <button type="button" class="stackshud__cardsbtn" id="stacks-cards-btn"><span data-l="en">Card index</span><span data-l="zh">索引卡</span> →</button>
    </div>
    <!-- the drawer that is out, and what hangs in it -->
    <aside class="stackshud__drawer" id="stacks-drawer" hidden data-no-i18n></aside>
    <!-- a file half out: read it here, or carry it to the table -->
    <aside class="stackshud__choice" id="stacks-choice" hidden data-no-i18n></aside>
    <p class="stackshud__callout micro" id="stacks-callout" aria-hidden="true" data-no-i18n></p>
    <aside class="stackshud__slip" id="stacks-slip" hidden data-no-i18n></aside>
    <!-- the card index drawer by the door, flipped through one card at a time -->
    <section class="icards" id="stacks-cards" hidden data-no-i18n aria-label="Card index"></section>
  </section>

  <!-- ===================== LINK ROOM ===================== -->
  <section class="wallhud" id="wallhud" aria-label="Link analysis">
    <button class="back" id="wall-back" type="button">
      <svg viewBox="0 0 24 12" aria-hidden="true"><path d="M24 6H2M7 1 2 6l5 5" /></svg>
      <span>Archive overview</span><span class="kbd">Esc</span>
    </button>
    <div class="wallhud__head">
      <span class="micro">Room 02 / Link analysis</span>
      <h1 class="wallhud__title">Red string</h1>
      <span class="micro"><span id="wall-count" data-records={records.length} data-links={links}>{records.length} records · {links} links</span> · <span id="wall-sweep">Sweep 00</span></span>
    </div>
    <div class="wallhud__note" id="wall-note" aria-live="polite">
      <span class="micro" id="wall-note-file">Hover a card to isolate its links</span>
      <p class="wallhud__name" id="wall-note-title"></p>
      <p class="wallhud__linked" id="wall-note-linked"></p>
    </div>
    <div class="wallhud__hints micro">
      <span>Drag cards</span><span>/</span><span>Click to open</span><span>/</span><span>← → Cycle</span>
      <button type="button" class="wallhud__reset" id="wall-reset">Reset wall</button>
    </div>
    <ol class="wallhud__list" id="wall-list">
      {records.map((r) => (
        <li data-file={r.file}>
          <a href={`${base}records/${r.slug}/`} data-file={r.file}><b>{r.file}</b> {r.title}</a>
          {r.related.length > 0 && <span> — linked to {r.related.join(', ')}</span>}
        </li>
      ))}
    </ol>
  </section>

  <!-- ===================== PROGRAMS CHAPTER ===================== -->
  <div class="chapter" id="chapter" aria-hidden="true" hidden>
    <i class="chapter__block"></i>
    <i class="chapter__wedge"></i>
    <i class="chapter__rule"></i>
    <span class="chapter__no micro"><span>Drawer</span> {programsNo} / <span>Chapter</span></span>
    <h2 class="chapter__title">programs</h2>
    <svg class="chapter__patch" viewBox="0 0 120 120">
      <defs><path id="patch-arc" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0" /></defs>
      <circle cx="60" cy="60" r="56" class="chapter__ring" />
      <circle cx="60" cy="60" r="34" class="chapter__inner" />
      <text class="chapter__arc"><textPath href="#patch-arc" textLength="272" lengthAdjust="spacing">RECORDS OFFICE · PROGRAMS · RECORDS OFFICE · PROGRAMS ·</textPath></text>
      <ellipse cx="60" cy="60" rx="30" ry="11" transform="rotate(-24 60 60)" class="chapter__orbit" />
      <circle cx="60" cy="60" r="6" class="chapter__core" />
      <circle cx="86" cy="48" r="2.6" class="chapter__sat" />
    </svg>
    <div class="chapter__grid micro">
      <span id="chapter-count" data-n={programs.length}>{programs.length} programs on file</span>
      {span && <span>{span}</span>}
      {programs.length > 0 && <span>{programs[0].file} → {programs[programs.length - 1].file}</span>}
    </div>
  </div>

  <canvas class="iris" id="iris" aria-hidden="true" hidden></canvas>

  <article class="dossier" id="dossier" aria-hidden="true">
    <span class="dossier__spine micro" id="ds-spine" aria-hidden="true">Archive terminal // Gerimis</span>
    <i class="dossier__scan" aria-hidden="true"></i>
    <!-- The sheet and what goes with it. At the reading table this is the part laid over the sheet on the blotter. -->
    <div class="dossier__sheet">
    <!-- Earlier drafts lie under the final; their tabs stick out past its edge -->
    <nav class="sheaf" id="ds-sheaf" aria-label="Earlier drafts" hidden></nav>
    <div class="dossier__scroll dossier__paper" id="ds-scroll">
      <header class="dossier__head">
        <div class="retrieve" id="ds-retrieve" aria-hidden="true">
          <div class="retrieve__in">
            <div class="retrieve__row micro"><b id="rt-state">Checking out</b><span id="rt-path"></span><span class="retrieve__pct" id="rt-pct">000%</span></div>
            <div class="retrieve__bar"><i id="rt-bar"></i></div>
            <p class="retrieve__tip"><span class="micro">Archivist tip</span><span id="rt-tip"></span></p>
          </div>
        </div>
        <div class="dossier__crumbs micro"><span id="ds-file">File P-0001</span><span class="barcode" id="ds-barcode" aria-hidden="true"></span></div>
        <p class="dossier__old micro" id="ds-old" hidden></p>
      <p class="dossier__light micro" id="ds-light" hidden data-no-i18n></p>
        <h2 class="dossier__title" id="ds-title"></h2>
        <p class="dossier__sub" id="ds-sub"></p>
        <button type="button" class="mystamp-btn micro" id="ds-mystamp" aria-label="Put your own stamp on this file"><span>Stamp</span></button>
        <span class="mystamp" id="ds-mystamp-ink" aria-hidden="true" hidden></span>
        <span class="superseded" aria-hidden="true" data-no-i18n>Superseded</span>
      </header>
      <dl class="dossier__meta" id="ds-meta"></dl>
      <section class="pane" id="ds-overview"></section>
      <section class="pane prose" id="ds-record"></section>
      <section class="pane pane--attach" id="ds-attach"></section>
      <p class="dossier__see" id="ds-see"></p>
    </div>
    <i class="dossier__shade" aria-hidden="true"></i>
    <!-- what else is lying on the reading table -->
    <div class="ds-table" id="ds-table" hidden data-no-i18n></div>
    </div>
    <div class="cite-slip" id="ds-slip" role="dialog" aria-label="File reference" hidden></div>
    <footer class="dossier__foot">
      <button type="button" class="dossier__step" data-dstep="-1"><svg viewBox="0 0 24 12" aria-hidden="true"><path d="M24 6H2M7 1 2 6l5 5" /></svg><span>Previous</span></button>
      <span class="micro" id="ds-count">01 / 04</span>
      <button type="button" class="dossier__step" data-dstep="1"><span>Next</span><svg viewBox="0 0 24 12" aria-hidden="true"><path d="M0 6h22M17 1l5 5-5 5" /></svg></button>
    </footer>
  </article>

  <!-- The second file on the table, laid alongside -->
  <aside class="companion" id="companion" aria-hidden="true" hidden data-no-i18n></aside>

  <!-- ===================== SEARCH ===================== -->
  <div class="search" id="search" role="dialog" aria-modal="true" aria-label="Search the archive" hidden>
    <div class="search__inner">
      <div class="search__top">
        <span class="micro">Archive index</span>
        <button type="button" class="search__close" id="search-close"><span>Close</span><span class="kbd">Esc</span></button>
      </div>
      <label class="search__field">
        <span class="sr-only">Search</span>
        <input id="search-input" type="search" placeholder="Search names, events, file numbers" autocomplete="off" spellcheck="false" />
      </label>
      <div class="search__count micro" id="search-count"></div>
      <ol class="search__list" id="search-list"></ol>
    </div>
  </div>

  <!-- ===================== BOOT ===================== -->
  <div class="boot" id="boot">
    <p class="boot__work micro" data-no-i18n>The Ninth Draft</p>
    <div class="boot__center">
      <Seal />
      <div class="boot__id">
        <span class="boot__dot"></span><span id="boot-line"></span>
      </div>
    </div>
    <button class="boot__enter" id="boot-enter" type="button">
      <span>Enter archive</span>
      <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1 11 11 1M3 1h8v8" /></svg>
    </button>
    <div class="boot__progress" aria-hidden="true"><i id="boot-bar"></i></div>
    <p class="boot__caption micro" id="boot-caption">Opening the reading room</p>
  </div>

  <noscript>
    <div class="noscript">This archive needs JavaScript to open its drawers.</div>
  </noscript>
</div>

<script type="application/json" id="archive-data" set:html={payload} />

<script>
  import { start } from '../app/main';
  start();
</script>
