---
/**
 * The street map: a 1999 street directory of the island you can drag and zoom
 * (src/app/map/street.ts draws it). The page's own script mounts it with
 * mountStreetMap (src/app/map/mount.ts).
 */
interface Props { id?: string; focus?: string; tall?: boolean }
const { id = 'smap', focus, tall } = Astro.props;
---

<div class={`smap${tall ? ' smap--tall' : ''}`} id={id} data-focus={focus}>
  <div class="smap__head micro">
    <span class="smap__title"><span data-l="en">Records Office · Survey Section · Street directory, 1999</span><span data-l="zh">记录署 · 测绘科 · 街道图，1999 年版</span></span>
    <span class="smap__corner" aria-live="polite"><b data-smap-page>—</b><span data-smap-where></span></span>
  </div>
  <div class="smap__frame">
    <canvas class="smap__canvas" tabindex="0" aria-label="Street map of Gerimis. Drag to move, scroll or pinch to turn to a closer scale, tap a district."></canvas>
    <p class="smap__wait micro" aria-hidden="true"><span data-l="en">Unfolding the sheet…</span><span data-l="zh">正在摊开图纸……</span></p>
    <aside class="smap__card" hidden aria-live="polite"></aside>
  </div>
  <div class="smap__foot micro">
    <div class="smap__zoom">
      <button type="button" data-z="out" aria-label="Wider scale">−</button>
      <button type="button" data-z="in" aria-label="Closer scale">+</button>
      <button type="button" data-z="reset" aria-label="Whole island"><span data-l="en">Whole island</span><span data-l="zh">全岛</span></button>
    </div>
    <p class="smap__credit"><span data-l="en">Map data © OpenStreetMap contributors, redrawn as in 1999</span><span data-l="zh">地图参考 © OpenStreetMap 贡献者，按 1999 年重绘</span></p>
  </div>
  <details class="smap__key micro">
    <summary><span data-l="en">Key</span><span data-l="zh">图例</span></summary>
    <ul>
      <li><i class="k-mw"></i><span data-l="en">Expressway</span><span data-l="zh">快速公路</span></li>
      <li><i class="k-pr"></i><span data-l="en">Main road</span><span data-l="zh">主要道路</span></li>
      <li><i class="k-rd"></i><span data-l="en">Road</span><span data-l="zh">道路</span></li>
      <li><i class="k-ns"></i><span data-l="en">North–South line</span><span data-l="zh">南北线</span></li>
      <li><i class="k-ew"></i><span data-l="en">East–West line</span><span data-l="zh">东西线</span></li>
      <li><i class="k-bp"></i><span data-l="en">Bukit Panjang LRT (from 6 Nov)</span><span data-l="zh">武吉班让轻轨（11 月 6 日起）</span></li>
      <li><i class="k-ne"></i><span data-l="en">North-East line, being dug</span><span data-l="zh">东北线，在挖</span></li>
      <li><i class="k-ktm"></i><span data-l="en">Railway across the strait</span><span data-l="zh">对岸铁路</span></li>
      <li><i class="k-spur"></i><span data-l="en">Jurong branch, disused</span><span data-l="zh">裕廊支线，停用</span></li>
      <li><i class="k-green"></i><span data-l="en">Park, nature reserve</span><span data-l="zh">公园、自然保护区</span></li>
      <li><i class="k-water"></i><span data-l="en">Reservoir</span><span data-l="zh">蓄水池</span></li>
      <li><i class="k-hdb"></i><span data-l="en">HDB block</span><span data-l="zh">组屋</span></li>
      <li><i class="k-bound"></i><span data-l="en">District bound</span><span data-l="zh">区界</span></li>
      <li><i class="k-old"></i><span data-l="en">Shore before the reclamation</span><span data-l="zh">填海前的海岸</span></li>
      <li><i class="k-blank"></i><span data-l="en">Not surveyed</span><span data-l="zh">未测绘</span></li>
      <li><i class="k-rec"></i><span data-l="en">Records on file</span><span data-l="zh">在档档案</span></li>
      <li><b class="k-fac"><span data-l="en">MKT</span><span data-l="zh">市</span></b><span data-l="en">Market and food centre</span><span data-l="zh">巴刹 · 熟食中心</span></li>
      <li><b class="k-fac is-solid"><span data-l="en">BUS</span><span data-l="zh">站</span></b><span data-l="en">Bus interchange</span><span data-l="zh">巴士转换站</span></li>
      <li><b class="k-fac is-solid"><span data-l="en">FERRY</span><span data-l="zh">渡</span></b><span data-l="en">Ferry terminal</span><span data-l="zh">渡轮码头</span></li>
      <li><b class="k-fac"><span data-l="en">SC</span><span data-l="zh">商</span></b><span data-l="en">Shopping centre</span><span data-l="zh">购物中心</span></li>
      <li><b class="k-fac"><span data-l="en">PO</span><span data-l="zh">邮</span></b><span data-l="en">Post office</span><span data-l="zh">邮局</span></li>
      <li><b class="k-fac"><span data-l="en">POLY</span><span data-l="zh">诊</span></b><span data-l="en">Polyclinic</span><span data-l="zh">综合诊疗所</span></li>
      <li><b class="k-fac"><span data-l="en">HOSP</span><span data-l="zh">医</span></b><span data-l="en">Hospital</span><span data-l="zh">医院</span></li>
      <li><b class="k-fac"><span data-l="en">CC</span><span data-l="zh">联</span></b><span data-l="en">Community centre</span><span data-l="zh">民众联络所</span></li>
      <li><b class="k-fac"><span data-l="en">LIB</span><span data-l="zh">图</span></b><span data-l="en">Public library</span><span data-l="zh">公共图书馆</span></li>
      <li><b class="k-fac"><span data-l="en">POOL</span><span data-l="zh">泳</span></b><span data-l="en">Swimming complex</span><span data-l="zh">游泳池</span></li>
      <li><b class="k-fac"><span data-l="en">SCH</span><span data-l="zh">校</span></b><span data-l="en">School</span><span data-l="zh">学校</span></li>
      <li><b class="k-fac"><span data-l="en">TPL · CH · MSQ</span><span data-l="zh">庙 · 堂 · 寺</span></b><span data-l="en">Temple, church, mosque</span><span data-l="zh">庙、教堂、清真寺</span></li>
      <li><b class="k-fac is-gone"><span data-l="en">PO</span><span data-l="zh">邮</span></b><span data-l="en">Closed before 1999</span><span data-l="zh">1999 年前已关闭</span></li>
    </ul>
  </details>
</div>
