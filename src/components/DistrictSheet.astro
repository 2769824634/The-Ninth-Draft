---
/**
 * One district on the survey sheet, close up: the same coast and pins as the
 * island map, cut to the square around the district, with every neighbour
 * that falls inside named.
 */
import { DISTRICTS, type District } from '../app/visitor/districts';
import { SHEET } from '../data/gerimis/districts';

interface Props { d: District }
const { d } = Astro.props;
const base = import.meta.env.BASE_URL;
const W = 300, H = 168;
const vx = Math.round(d.x - W / 2), vy = Math.round(d.y - H / 2);
const inView = DISTRICTS.filter((x) => x.x > vx - 10 && x.x < vx + W + 10 && x.y > vy - 10 && x.y < vy + H + 10);
// grid lines every 50 units, numbered like the island sheet (columns A–J, rows 01–06 at every hundred)
const xs = Array.from({ length: 22 }, (_, i) => i * 50).filter((x) => x > vx && x < vx + W);
const ys = Array.from({ length: 13 }, (_, i) => i * 50).filter((y) => y > vy && y < vy + H);
---

<svg class="dsheet" viewBox={`${vx} ${vy} ${W} ${H}`} role="img" aria-label={`${d.en} on the survey sheet`}>
  <g class="dsheet__grid" aria-hidden="true">
    {xs.map((x) => <line x1={x} y1={vy} x2={x} y2={vy + H} class={x % 100 ? 'is-half' : ''} />)}
    {ys.map((y) => <line x1={vx} y1={y} x2={vx + W} y2={y} class={y % 100 ? 'is-half' : ''} />)}
  </g>
  <g aria-hidden="true">
    <path class="dsheet__land" d={SHEET.coast} />
    {SHEET.islands.map((p) => <path class="dsheet__land" d={p} />)}
    <path class="dsheet__old" d={SHEET.oldShore} />
  </g>
  {inView.map((x) => {
    const me = x.id === d.id;
    // names near the edge of the cut turn inwards
    const left = x.x > vx + W * 0.72 ? true : x.x < vx + W * 0.28 ? false : x.left;
    const label = { x: left ? x.x - 5 : x.x + 5, anchor: left ? 'end' : 'start' };
    return (
      <a href={`${base}district/${x.id}/`} class={`dsheet__d is-${x.kind}${me ? ' is-me' : ''}`} aria-label={x.en} aria-current={me ? 'page' : undefined}>
        {me && <circle class="dsheet__ring" cx={x.x} cy={x.y} r="9" />}
        {x.kind === 'unsurveyed'
          ? <rect class="dsheet__mark" x={x.x - 2.4} y={x.y - 2.4} width="4.8" height="4.8" />
          : <circle class="dsheet__mark" cx={x.x} cy={x.y} r={me ? 3 : 2.2} />}
        <text x={label.x} y={x.y + 1.8} text-anchor={label.anchor}><tspan data-l="en">{x.en}</tspan><tspan data-l="zh">{x.zh}</tspan></text>
      </a>
    );
  })}
</svg>
