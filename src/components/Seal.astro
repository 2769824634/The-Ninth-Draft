---
/* Archive seal: drafted in thin strokes, drawn on during boot. */
---

<svg class="seal" viewBox="0 0 240 240" role="img" aria-label="Seal of the Gerimis Records Office">
  <defs>
    <path id="seal-ring" d="M120 120 m-86 0 a86 86 0 1 1 172 0 a86 86 0 1 1 -172 0" />
  </defs>
  <circle class="seal__draw" cx="120" cy="120" r="104" pathLength="1" />
  <circle class="seal__draw seal__thin" cx="120" cy="120" r="98" pathLength="1" />
  <circle class="seal__draw seal__thin" cx="120" cy="120" r="70" pathLength="1" />
  <text class="seal__text"><textPath href="#seal-ring" startOffset="0">RECORDS OFFICE · PUBLIC ARCHIVE · GERIMIS · MCMXCIX ·</textPath></text>
  <ellipse class="seal__draw seal__orbit" cx="120" cy="120" rx="112" ry="34" transform="rotate(-24 120 120)" pathLength="1" />
  <circle class="seal__sat" cx="0" cy="0" r="4" />
  <text class="seal__nine" x="120" y="146" text-anchor="middle">9</text>
  <path class="seal__draw seal__thin" d="M92 160 H148" pathLength="1" />
</svg>
